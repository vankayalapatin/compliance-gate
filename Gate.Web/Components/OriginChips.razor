@using Gate.Web.ViewModels
@if (RecordLabels.IsAgentMade(Source))
{
    <AgentBanner Source="@Source" />
}
@if (RecordLabels.IsOpeningDoc(Number, Opening))
{
    <span class="gate-chip">@RecordLabels.OpeningData</span>
}

@code {
    [Parameter]
    public string? Number { get; set; }

    [Parameter]
    public string? Source { get; set; }

    [Parameter]
    public IReadOnlySet<string> Opening { get; set; } = new HashSet<string>(StringComparer.Ordinal);
}
