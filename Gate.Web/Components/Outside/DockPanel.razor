@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<div id="dock">
    @if (_loading)
    {
        <p class="gate-meta">Loading expected trucks…</p>
    }
    @if (_loadError is not null)
    {
        <ErrorBox Message="@_loadError" />
    }
    @if (_trucks is not null)
    {
        @foreach (var note in _trucks.Notes)
        {
            <div class="gate-notice" role="alert">@note</div>
        }
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Expected trucks (@_trucks.Trucks.Count)</p>
            </div>
            <p class="gate-meta">You are the dock camera. Each truck is a shipment waiting on dock evidence. Images in, reads out: the dock check transcribes and judges every label.</p>
            @if (_trucks.Trucks.Count == 0)
            {
                <p class="gate-meta">No expected trucks; nothing is waiting at the dock.</p>
            }
        </section>
        @foreach (var gone in _states.Where(s => s.Value.Outcome is not null && !_trucks.Trucks.Any(t => string.Equals(t.AsnNumber, s.Key, StringComparison.Ordinal))))
        {
            <section class="gate-card">
                <div class="gate-card-head">
                    <p class="gate-card-title">Latest result for truck @gone.Key</p>
                </div>
                <OutcomeBox Outcome="@gone.Value.Outcome" CaseId="@gone.Value.CaseId" />
            </section>
        }
        @foreach (var truck in _trucks.Trucks)
        {
            var state = StateFor(truck.AsnNumber);
            <section class="gate-card">
                <div class="gate-card-head">
                    <p class="gate-card-title">Truck @truck.AsnNumber</p>
                    <div class="gate-card-badges">
                        <span class="gate-chip">PO @truck.PoNumber</span>
                        @if (truck.VendorId is not null)
                        {
                            <span class="gate-chip">@truck.VendorId</span>
                        }
                    </div>
                </div>
                @if (truck.CaseId is null)
                {
                    <div class="gate-notice" role="alert">No case links this truck yet; photos wait for the case.</div>
                }
                else
                {
                    <p class="gate-meta">Case <a href="cases/@truck.CaseId">@truck.CaseId</a></p>
                }
                <p class="gate-row"><span class="gate-label">Cartons (@truck.Cartons.Count):</span></p>
                @if (truck.Cartons.Count == 0)
                {
                    <p class="gate-meta">No cartons on this notice.</p>
                }
                else
                {
                    <ul class="gate-list">
                        @foreach (var carton in truck.Cartons)
                        {
                            <li>@carton.CartonId · @carton.ItemId · @carton.UnitsPerCarton units · lot @carton.LotRef</li>
                        }
                    </ul>
                }
                <label class="gate-checkline" for="reshot-@truck.AsnNumber">
                    <input type="checkbox" id="reshot-@truck.AsnNumber" checked="@state.Reshot" @onchange="e => state.Reshot = e.Value is true" />
                    Reshot (follow-up reads for picked cartons)
                </label>
                @if (state.Reshot)
                {
                    <p class="gate-row"><span class="gate-label">Cartons covered:</span></p>
                    @foreach (var carton in truck.Cartons)
                    {
                        <label class="gate-checkline" for="reshot-@truck.AsnNumber-@carton.CartonId">
                            <input type="checkbox" id="reshot-@truck.AsnNumber-@carton.CartonId"
                                   checked="@state.ReshotCartons.Contains(carton.CartonId, StringComparer.Ordinal)"
                                   @onchange="e => ToggleReshotCarton(state, carton.CartonId, e.Value is true)" />
                            @carton.CartonId
                        </label>
                    }
                    <div class="gate-actions">
                        <button class="gate-btn" disabled="@_busy" @onclick="() => MintCloseUpsAsync(truck, state)">Mint close-up for picked cartons</button>
                    </div>
                    @if (state.MintNote is not null)
                    {
                        <p class="gate-meta">@state.MintNote</p>
                    }
                }
                <p class="gate-row"><span class="gate-label">Rebuild views with a simulated problem</span></p>
                <p class="gate-meta">Pick a problem per carton, then rebuild. The rebuilt views land on the counter and go out with the normal send below.</p>
                @foreach (var carton in truck.Cartons)
                {
                    <div class="gate-field">
                        <span class="gate-row">@carton.CartonId</span>
                        <select class="gate-select" value="@RebuildProblemFor(state, carton.CartonId)" @onchange="e => SetRebuildProblem(state, carton.CartonId, e.Value?.ToString())" aria-label="Simulated problem for @carton.CartonId">
                            @foreach (var option in DockProblemKinds.PickerOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                }
                <div class="gate-actions">
                    <button class="gate-btn" disabled="@_busy" @onclick="() => RebuildViewsAsync(truck, state)">Rebuild views</button>
                </div>
                @if (state.RebuildNote is not null)
                {
                    <p class="gate-meta">@state.RebuildNote</p>
                }
                <p class="gate-row"><span class="gate-label">Counter images @(state.Reshot ? "(close-ups)" : "(pallet views)")</span></p>
                @{
                    var offered = DockPhotoService.OfferedCounterImages(TruckImages(Options.DockImages, truck.AsnNumber, state), state.Reshot);
                }
                @if (offered.Count == 0)
                {
                    <p class="gate-meta">@(state.Reshot ? "No close-up on the counter; upload a file below." : "No pallet views on the counter; upload files below.")</p>
                }
                @foreach (var image in offered)
                {
                    <div class="gate-field">
                        <label class="gate-checkline" for="dockimg-@truck.AsnNumber-@image">
                            <input type="checkbox" id="dockimg-@truck.AsnNumber-@image"
                                   checked="@state.ServerPicks.ContainsKey(image)"
                                   @onchange="e => ToggleServerImage(state, image, e.Value is true)" />
                            @image
                        </label>
                        <img src="dock-images/@image" alt="@image" class="gate-thumb" />
                        <select class="gate-select" value="@HintFor(state, image)" @onchange="e => SetHint(state, image, e.Value?.ToString())" disabled="@(!state.ServerPicks.ContainsKey(image))">
                            <option value="">— no carton hint —</option>
                            @foreach (var carton in truck.Cartons)
                            {
                                <option value="@carton.CartonId">@carton.CartonId</option>
                            }
                        </select>
                    </div>
                }
                <p class="gate-row"><span class="gate-label">Upload files</span></p>
                <InputFile id="@($"dock-upload-{truck.AsnNumber}")" multiple accept=".jpg,.jpeg" OnChange="e => OnUploadAsync(state, e)" />
                @foreach (var row in state.Uploads)
                {
                    <div class="gate-field">
                        <span class="gate-row">@row.FileName (@row.Bytes.Length bytes)</span>
                        <select class="gate-select" @bind="row.CartonHint">
                            <option value="">— no carton hint —</option>
                            @foreach (var carton in truck.Cartons)
                            {
                                <option value="@carton.CartonId">@carton.CartonId</option>
                            }
                        </select>
                        <div class="gate-actions">
                            <button class="gate-btn" disabled="@_busy" @onclick="() => state.Uploads.Remove(row)">Remove</button>
                        </div>
                    </div>
                }
                <div class="gate-actions">
                    <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="() => SubmitAsync(truck)">@(state.Reshot ? "Send reshot" : "Send dock photos")</button>
                    @if (_busy)
                    {
                        <span class="gate-meta">Transcribing and judging…</span>
                    }
                </div>
                @if (state.UploadError is not null)
                {
                    <ErrorBox Message="@state.UploadError" />
                }
                <OutcomeBox Outcome="@state.Outcome" CaseId="@truck.CaseId" />
            </section>
        }
    }
</div>

@code {
    private const long MaxUploadBytes = 15L * 1024 * 1024;

    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ExpectedTrucks? _trucks;
    private string? _loadError;
    private bool _loading = true;
    private bool _busy;
    private readonly Dictionary<string, TruckState> _states = new(StringComparer.Ordinal);

    private sealed class TruckState
    {
        public bool Reshot;
        public string? CaseId;
        public SimulationOutcome? Outcome;
        public string? UploadError;
        public string? MintNote;
        public string? RebuildNote;
        public readonly HashSet<string> ReshotCartons = new(StringComparer.Ordinal);
        public readonly Dictionary<string, string?> ServerPicks = new(StringComparer.Ordinal);
        public readonly Dictionary<string, string?> RebuildProblems = new(StringComparer.Ordinal);
        public readonly List<UploadRow> Uploads = [];
        public readonly List<string> MintedFiles = [];
    }

    private static IReadOnlyList<string> TruckImages(
        IReadOnlyList<string> files, string asnNumber, TruckState state)
    {
        var all = files.Concat(state.MintedFiles).Distinct(StringComparer.Ordinal).ToList();
        var own = all.Where(f => f.StartsWith(asnNumber + "-", StringComparison.Ordinal)).ToList();
        // This truck's own ASN-labeled photos when they exist; otherwise the
        // legacy unprefixed set (other trucks' photos never leak across).
        return own.Count > 0
            ? own
            : all.Where(f => f.StartsWith("IMG-", StringComparison.Ordinal)).ToList();
    }

    private async Task MintCloseUpsAsync(ExpectedTruckVm truck, TruckState state)
    {
        state.MintNote = null;
        if (truck.CaseId is null)
        {
            state.MintNote = "No case links this truck yet; close-ups wait for the case.";
            return;
        }

        if (state.ReshotCartons.Count == 0)
        {
            state.MintNote = "Pick at least one carton the close-up covers.";
            return;
        }

        _busy = true;
        try
        {
            var notes = new List<string>();
            foreach (var carton in state.ReshotCartons.Order(StringComparer.Ordinal).ToList())
            {
                var minted = await Simulate.MintReshotImageAsync(truck.CaseId, carton);
                notes.Add(minted.Message);
                if (minted.Ok && minted.FileName is not null)
                {
                    if (!state.MintedFiles.Contains(minted.FileName, StringComparer.Ordinal))
                    {
                        state.MintedFiles.Add(minted.FileName);
                    }

                    state.ServerPicks[minted.FileName] = carton;
                }
            }

            state.MintNote = string.Join(" ", notes);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class UploadRow
    {
        public string FileName { get; set; } = string.Empty;
        public byte[] Bytes { get; set; } = [];
        public string? CartonHint { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _trucks = await Simulate.ListExpectedTrucksAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Expected trucks failed to load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private TruckState StateFor(string asnNumber)
    {
        if (!_states.TryGetValue(asnNumber, out var state))
        {
            state = new TruckState();
            _states[asnNumber] = state;
        }

        return state;
    }

    private static string HintFor(TruckState state, string image) =>
        state.ServerPicks.TryGetValue(image, out var hint) ? hint ?? string.Empty : string.Empty;

    private static void SetHint(TruckState state, string image, string? hint)
    {
        if (state.ServerPicks.ContainsKey(image))
        {
            state.ServerPicks[image] = string.IsNullOrWhiteSpace(hint) ? null : hint;
        }
    }

    private static void ToggleServerImage(TruckState state, string image, bool picked)
    {
        if (picked)
        {
            state.ServerPicks.TryAdd(image, null);
        }
        else
        {
            state.ServerPicks.Remove(image);
        }
    }

    private static void ToggleReshotCarton(TruckState state, string carton, bool picked)
    {
        if (picked)
        {
            state.ReshotCartons.Add(carton);
        }
        else
        {
            state.ReshotCartons.Remove(carton);
        }
    }

    private static string RebuildProblemFor(TruckState state, string cartonId) =>
        state.RebuildProblems.TryGetValue(cartonId, out var kind) ? kind ?? string.Empty : string.Empty;

    private static void SetRebuildProblem(TruckState state, string cartonId, string? kind)
    {
        if (string.IsNullOrWhiteSpace(kind))
        {
            state.RebuildProblems.Remove(cartonId);
        }
        else
        {
            state.RebuildProblems[cartonId] = kind;
        }
    }

    private async Task RebuildViewsAsync(ExpectedTruckVm truck, TruckState state)
    {
        state.RebuildNote = null;
        if (truck.CaseId is null)
        {
            state.RebuildNote = "No case links this truck yet; rebuilds wait for the case.";
            return;
        }

        _busy = true;
        try
        {
            var problems = state.RebuildProblems
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .Select(kv => new DockProblemForm(kv.Key, kv.Value!))
                .ToList();
            var rebuilt = await Simulate.RebuildDockViewsAsync(truck.CaseId, problems);
            state.RebuildNote = rebuilt.Message;
            if (rebuilt.Ok)
            {
                // Rebuilt views join the counter and go out through the
                // normal dock photo send below.
                foreach (var file in rebuilt.FileNames)
                {
                    if (!state.MintedFiles.Contains(file, StringComparer.Ordinal))
                    {
                        state.MintedFiles.Add(file);
                    }

                    state.ServerPicks.TryAdd(file, null);
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnUploadAsync(TruckState state, InputFileChangeEventArgs e)
    {
        state.UploadError = null;
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                using var stream = file.OpenReadStream(MaxUploadBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                state.Uploads.Add(new UploadRow { FileName = file.Name, Bytes = buffer.ToArray() });
            }
            catch (Exception ex)
            {
                state.UploadError = $"Upload {file.Name} failed: {ex.Message}.";
            }
        }
    }

    private async Task SubmitAsync(ExpectedTruckVm truck)
    {
        var state = StateFor(truck.AsnNumber);
        _busy = true;
        state.Outcome = null;
        state.CaseId = truck.CaseId;
        try
        {
            var photos = new List<SimulationPhoto>();
            var dropped = new List<string>();
            foreach (var pick in state.ServerPicks)
            {
                // Dock-camera modes never mix: a pick from the other mode
                // (ticked before the reshot toggle flipped) stays out of
                // this send and is named in the outcome, never silently
                // omitted. The pick stays ticked for its own mode.
                if (DockPhotoService.IsCloseUp(pick.Key) != state.Reshot)
                {
                    dropped.Add(pick.Key);
                    continue;
                }

                var (bytes, error) = await Simulate.TryReadDockImageAsync(pick.Key);
                if (bytes is null)
                {
                    state.Outcome = new SimulationOutcome(false, error ?? $"Image {pick.Key} is not available.", [], []);
                    return;
                }

                photos.Add(new SimulationPhoto(pick.Key, bytes, pick.Value));
            }

            photos.AddRange(state.Uploads.Select(u => new SimulationPhoto(u.FileName, u.Bytes, u.CartonHint)));

            var sent = state.Reshot
                ? await Simulate.SendReshotAsync(truck.CaseId, state.ReshotCartons.ToList(), photos)
                : await Simulate.SendDockPhotosAsync(truck.CaseId, photos);
            state.Outcome = dropped.Count == 0
                ? sent
                : sent with
                {
                    Details = [.. sent.Details,
                        $"Left out of this send (other dock-camera mode): {string.Join(", ", dropped.Order(StringComparer.Ordinal))}."]
                };
            if (state.Outcome.Ok)
            {
                await ReloadAsync();
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            state.Outcome = new SimulationOutcome(false, $"Dock photos failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
