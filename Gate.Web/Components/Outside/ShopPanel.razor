@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<div id="shop">
    <section class="gate-card">
        <div class="gate-card-head">
            <p class="gate-card-title">Customer shop</p>
            <div class="gate-card-badges">
                <span class="gate-chip">@Options.EntityCode</span>
            </div>
        </div>
        <p class="gate-meta">You are the customer. A new shop order carries its own lines plus currency. The shop sends a shop order id and the ERP mints the sales order — the new number shows below.</p>
        <div class="gate-field">
            <label class="gate-label" for="order-requester">Requester (blank uses the ERP default)</label>
            <select class="gate-select" id="order-requester" @bind="_requester">
                <option value="">— ERP default requester —</option>
                @foreach (var user in Options.Users)
                {
                    <option value="@user.UserId">@user.UserId (@user.Role)</option>
                }
            </select>
        </div>
        <div class="gate-field">
            <label class="gate-label" for="shop-new-currency">Currency</label>
            <input class="gate-input" id="shop-new-currency" @bind="_currency" />
        </div>
        <p class="gate-row"><span class="gate-label">Candidate vendors (from the vendor master):</span></p>
        @if (Options.CandidateVendorsByItem.Count == 0)
        {
            <p class="gate-meta">None in the vendor master; the order proceeds without a candidate map.</p>
        }
        else
        {
            <ul class="gate-list">
                @foreach (var kv in Options.CandidateVendorsByItem.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                {
                    <li>@kv.Key ← @string.Join(", ", kv.Value)</li>
                }
            </ul>
        }
        <p class="gate-row"><span class="gate-label">Order lines</span></p>
        @foreach (var line in _lines)
        {
            <div class="gate-field">
                <select class="gate-select" value="@line.ItemId" @onchange="e => line.ItemId = e.Value?.ToString() ?? string.Empty" aria-label="Item">
                    <option value="">— item —</option>
                    @foreach (var item in Options.Items)
                    {
                        <option value="@item.ItemId">@item.ItemId@(string.IsNullOrEmpty(item.Unit) ? "" : $" ({item.Unit})")</option>
                    }
                </select>
                <input class="gate-input" type="number" min="0" step="any" value="@line.Quantity" @onchange="e => line.Quantity = ParseDecimal(e.Value?.ToString())" placeholder="quantity" aria-label="Quantity" />
                <div class="gate-actions">
                    <button class="gate-btn" disabled="@_busy" @onclick="() => _lines.Remove(line)">Remove</button>
                </div>
            </div>
        }
        <div class="gate-actions">
            <button class="gate-btn" disabled="@_busy" @onclick="() => _lines.Add(new OrderLineRow())">Add line</button>
        </div>
        <div class="gate-actions">
            <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitNewAsync">Place new order</button>
            @if (_busy)
            {
                <span class="gate-meta">Sending…</span>
            }
        </div>
        @if (_placed is not null && _placed.MintedSoNumbers.Count > 0)
        {
            <div class="gate-notice gate-notice-ok" role="alert">ERP minted @string.Join(", ", _placed.MintedSoNumbers) from shop order @_placed.ShopOrderId.</div>
        }
        else if (_placed is not null && _placed.Outcome.Ok)
        {
            <div class="gate-notice" role="alert">Shop order @_placed.ShopOrderId accepted; the minted sales order is not recorded yet.</div>
        }
        <OutcomeBox Outcome="@_newOutcome" />
    </section>
</div>

@code {
    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string _entityCode = string.Empty;
    private string _currency = string.Empty;
    private string? _requester;
    private bool _busy;
    private SimulationOutcome? _newOutcome;
    private ShopOrderPlaced? _placed;
    private readonly List<OrderLineRow> _lines = [new()];

    private sealed class OrderLineRow
    {
        public string ItemId { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_entityCode))
        {
            _entityCode = Options.EntityCode;
        }

        if (string.IsNullOrEmpty(_currency))
        {
            _currency = Options.Currency;
        }
    }

    private static decimal ParseDecimal(string? text) =>
        decimal.TryParse(text, out var value) ? value : 0m;

    private async Task SubmitNewAsync()
    {
        _busy = true;
        _newOutcome = null;
        _placed = null;
        try
        {
            _placed = await Simulate.SendNewShopOrderAsync(new NewShopOrder(
                _entityCode,
                string.IsNullOrWhiteSpace(_requester) ? null : _requester,
                Options.CandidateVendorsByItem.Count == 0 ? null : Options.CandidateVendorsByItem,
                _lines.Select(l => new OrderLineForm(l.ItemId, l.Quantity)).ToList(),
                _currency));
            _newOutcome = _placed.Outcome;
            if (_newOutcome.Ok)
            {
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _newOutcome = new SimulationOutcome(false, $"Placing the new order failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
