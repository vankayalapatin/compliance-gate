@using Gate.Contracts
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<div id="supplier-@VendorId">
    @if (_loadingPos)
    {
        <p class="gate-meta">Loading purchase orders…</p>
    }
    @if (_posError is not null)
    {
        <ErrorBox Message="@_posError" />
    }
    @if (_pos is not null)
    {
        @foreach (var note in _pos.Notes)
        {
            <div class="gate-notice" role="alert">@note</div>
        }
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Purchase orders for @VendorNameFor(VendorId) (@_pos.Pos.Count)</p>
            </div>
            @if (_pos.Pos.Count == 0)
            {
                <p class="gate-meta">No purchase orders for this supplier yet.</p>
            }
            else
            {
                <div class="gate-field">
                    <label class="gate-label" for="portal-po">Purchase order</label>
                    <select class="gate-select" id="portal-po" value="@_poNumber" @onchange="OnPoChanged">
                        @foreach (var po in _pos.Pos)
                        {
                            <option value="@po.PoNumber">@po.PoNumber · @po.ApprovalStatus / @po.DocStatus · @po.Total @po.Currency</option>
                        }
                    </select>
                </div>
            }
        </section>
    }
    @if (_loading)
    {
        <p class="gate-meta">Loading inbox…</p>
    }
    @if (_inboxError is not null)
    {
        <ErrorBox Message="@_inboxError" />
    }
    @if (_inbox is not null)
    {
        @foreach (var note in _inbox.Notes)
        {
            <div class="gate-notice" role="alert">@note</div>
        }

        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Our purchase order</p>
            </div>
            @if (_inbox.Po is null)
            {
                <p class="gate-meta">No purchase order selected.</p>
            }
            else
            {
                var po = _inbox.Po;
                <p class="gate-row">
                    <span class="gate-label">@po.PoNumber</span>
                    · vendor @VendorNameFor(po.VendorId) · terms @po.PaymentTermsId
                    · @po.ApprovalStatus / @po.DocStatus · @po.Currency
                </p>
                <table class="gate-table">
                    <thead>
                        <tr><th>Line</th><th>Item</th><th class="gate-num">Ordered</th><th class="gate-num">Unit price</th><th class="gate-num">Amount</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in po.Lines)
                        {
                            <tr>
                                <td>@line.PoLineRef</td>
                                <td>@line.ItemId</td>
                                <td class="gate-num">@line.QtyOrdered</td>
                                <td class="gate-num">@line.UnitPrice @po.Currency</td>
                                <td class="gate-num">@line.LineAmount @po.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="gate-row"><span class="gate-label">Total:</span> <span class="gate-num">@po.Total @po.Currency</span></p>
            }
        </section>

        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Already sent</p>
            </div>
            @if (_inbox.SentSteps.Count == 0)
            {
                <p class="gate-meta">Nothing sent on this order yet.</p>
            }
            else
            {
                <ul class="gate-list">
                    @foreach (var step in _inbox.SentSteps)
                    {
                        <li>@step.Step — @step.Detail</li>
                    }
                </ul>
            }
        </section>

        @if ((_ackOutcome ?? _asnOutcome ?? _invOutcome) is not null)
        {
            <section class="gate-card">
                <div class="gate-card-head">
                    <p class="gate-card-title">Latest result</p>
                </div>
                <OutcomeBox Outcome="@(_ackOutcome ?? _asnOutcome ?? _invOutcome)" CaseId="@CaseOrNull()" />
            </section>
        }
        @if (_inbox.NextAction == SupplierNextAction.WaitApproval)
        {
            <div class="gate-notice" role="alert">Waiting on buyer approval before anything can be sent.</div>
        }
        @if (_inbox.NextAction == SupplierNextAction.Closed)
        {
            <div class="gate-notice" role="alert">This order is closed; nothing more to send.</div>
        }
        @if (_inbox.NextAction == SupplierNextAction.Done && !_extraSends)
        {
            <div class="gate-notice gate-notice-ok" role="alert">This order is fully sent.</div>
            <div class="gate-actions">
                <button class="gate-btn" disabled="@_busy" @onclick="() => _extraSends = true">Send another shipment notice or invoice</button>
            </div>
        }
        @if (_inbox.NextAction == SupplierNextAction.Done && _extraSends)
        {
            <div class="gate-actions">
                <button class="gate-btn" disabled="@_busy" @onclick="() => _extraSends = false">Hide extra sends</button>
            </div>
        }
        @if (ShowAck())
        {
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Acknowledge</p>
            </div>
            <p class="gate-meta">Confirm the full ordered quantity. The ERP refuses when the order is not approved.</p>
            <div class="gate-field">
                <label class="gate-label" for="ack-date">Confirm date (blank means today)</label>
                <input class="gate-input" id="ack-date" type="date" value="@_confirmDate" @onchange="e => _confirmDate = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="gate-actions">
                <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitAckAsync">Acknowledge</button>
                @if (_busy)
                {
                    <span class="gate-meta">Sending…</span>
                }
            </div>
        </section>
        }

        @if (ShowShip())
        {
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Send a shipment notice</p>
            </div>
            <div class="gate-field">
                <label class="gate-label" for="asn-number">ASN number</label>
                <input class="gate-input" id="asn-number" @bind="_asnNumber" />
            </div>
            <div class="gate-field">
                <label class="gate-label" for="asn-slip">Packing-slip number</label>
                <input class="gate-input" id="asn-slip" @bind="_slip" />
            </div>
            <p class="gate-row"><span class="gate-label">Cartons (planned from the order lines and pack sizes; edit before sending)</span></p>
            @foreach (var row in _asnCartons)
            {
                <div class="gate-field">
                    <input class="gate-input" value="@row.CartonId" @onchange="e => row.CartonId = e.Value?.ToString() ?? string.Empty" placeholder="carton id" aria-label="Carton id" />
                    <input class="gate-input" value="@row.ItemId" @onchange="e => row.ItemId = e.Value?.ToString() ?? string.Empty" placeholder="item" aria-label="Item" />
                    <input class="gate-input" type="number" min="0" step="1" value="@row.Units" @onchange="e => row.Units = ParseInt(e.Value?.ToString())" placeholder="units per carton" aria-label="Units per carton" />
                    <input class="gate-input" value="@row.LotRef" @onchange="e => row.LotRef = e.Value?.ToString() ?? string.Empty" placeholder="supplier lot ref" aria-label="Supplier lot ref" />
                    <div class="gate-actions">
                        <button class="gate-btn" disabled="@_busy" @onclick="() => _asnCartons.Remove(row)">Remove</button>
                    </div>
                </div>
            }
            <div class="gate-actions">
                <button class="gate-btn" disabled="@_busy" @onclick="() => _asnCartons.Add(new AsnRow())">Add carton</button>
                <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitAsnAsync">Send shipment notice</button>
                @if (_busy)
                {
                    <span class="gate-meta">Sending…</span>
                }
            </div>
        </section>
        }

        @if (ShowInvoice())
        {
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Send an invoice</p>
            </div>
            <label class="gate-checkline" for="inv-photo">
                <input type="checkbox" id="inv-photo" @bind="_photoMode" />
                Invoice photos instead of typed lines
            </label>
            @if (_photoMode)
            {
                <div class="gate-field">
                    <label class="gate-label" for="inv-files">Invoice photos (one per page, in order)</label>
                    <div><InputFile id="inv-files" multiple accept=".jpg,.jpeg" OnChange="OnUploadAsync" /></div>
                </div>
                @foreach (var row in _uploads)
                {
                    <div class="gate-field">
                        <span class="gate-row">@row.FileName (@row.Bytes.Length bytes)</span>
                        <div class="gate-actions">
                            <button class="gate-btn" disabled="@_busy" @onclick="() => _uploads.Remove(row)">Remove</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="gate-field">
                    <label class="gate-label" for="inv-number">Supplier invoice number</label>
                    <input class="gate-input" id="inv-number" @bind="_invNumber" />
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="inv-vendor">Vendor (blank holds for AP)</label>
                    <select class="gate-select" id="inv-vendor" @bind="_invVendor">
                        <option value="">— blank —</option>
                        @foreach (var vendor in Options.Vendors)
                        {
                            <option value="@vendor.VendorId">@vendor.VendorId (@vendor.Name)</option>
                        }
                    </select>
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="inv-po">PO (blank holds for AP)</label>
                    <select class="gate-select" id="inv-po" value="@_invPo" @onchange="OnInvoicePoChanged">
                        <option value="">— blank —</option>
                        @foreach (var poNumber in PoChoices())
                        {
                            <option value="@poNumber">@poNumber</option>
                        }
                    </select>
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="inv-bank">Remittance bank ref (optional)</label>
                    <input class="gate-input" id="inv-bank" @bind="_bankRef" />
                </div>
                <p class="gate-row"><span class="gate-label">Invoice lines</span></p>
                <datalist id="poline-refs">
                    @foreach (var poLine in _poLines)
                    {
                        <option value="@poLine.PoLineRef">@poLine.ItemId · ordered @poLine.QtyOrdered</option>
                    }
                </datalist>
                @foreach (var line in _invLines)
                {
                    <div class="gate-field">
                        <input class="gate-input" list="poline-refs" value="@line.PoLineRef" @onchange="e => line.PoLineRef = e.Value?.ToString()" placeholder="PO line ref (blank holds for AP)" aria-label="PO line ref" />
                        <input class="gate-input" type="number" min="0" step="any" value="@line.Quantity" @onchange="e => line.Quantity = ParseDecimal(e.Value?.ToString())" placeholder="quantity" aria-label="Quantity" />
                        <input class="gate-input" type="number" min="0" step="any" value="@line.UnitPrice" @onchange="e => line.UnitPrice = ParseDecimal(e.Value?.ToString())" placeholder="unit price" aria-label="Unit price" />
                        <div class="gate-actions">
                            <button class="gate-btn" disabled="@_busy" @onclick="() => _invLines.Remove(line)">Remove</button>
                        </div>
                    </div>
                }
                <div class="gate-actions">
                    <button class="gate-btn" disabled="@_busy" @onclick="() => _invLines.Add(new InvRow())">Add line</button>
                </div>
            }
            <div class="gate-actions">
                <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitInvoiceAsync">Send invoice</button>
                @if (_busy)
                {
                    <span class="gate-meta">Sending…</span>
                }
            </div>
            @if (_uploadError is not null)
            {
                <ErrorBox Message="@_uploadError" />
            }
        </section>
        }

        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Mail with us (@_inbox.Mail.Count)</p>
            </div>
            @if (_inbox.Mail.Count == 0)
            {
                <p class="gate-meta">No email on this order yet.</p>
            }
        </section>
        @foreach (var mail in _inbox.Mail)
        {
            <section class="gate-card">
                <div class="gate-card-head">
                    <p class="gate-card-title">@mail.Subject</p>
                    @if (string.Equals(mail.From, RecordSource.P2pAgent, StringComparison.Ordinal))
                    {
                        <div class="gate-card-badges">
                            <AgentBanner Source="@RecordSource.P2pAgent" />
                        </div>
                    }
                </div>
                <p class="gate-meta">@mail.EmailId · from @mail.From · to @mail.To · sent @mail.SentAt.ToString("u")@(mail.InReplyTo is null ? "" : $" · in reply to {mail.InReplyTo}")@(mail.InvoiceRef is null ? "" : $" · invoice {mail.InvoiceRef}")</p>
                <p class="gate-row">@mail.Body</p>
            </section>
        }

        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">Reply to us</p>
            </div>
            @if (_company is not null)
            {
                <p class="gate-meta">You are replying to @_company.LegalName (@_company.EntityCode). Our purchasing mailbox is @_company.SenderEmail.</p>
            }
            <div class="gate-field">
                <label class="gate-label" for="reply-from">From (vendor address)</label>
                <input class="gate-input" id="reply-from" @bind="_from" />
            </div>
            <div class="gate-field">
                <label class="gate-label" for="reply-inreplyto">In reply to</label>
                <select class="gate-select" id="reply-inreplyto" @bind="_inReplyTo">
                    <option value="">— none —</option>
                    @foreach (var mail in _inbox.Mail)
                    {
                        <option value="@mail.EmailId">@mail.EmailId (@mail.Subject)</option>
                    }
                </select>
            </div>
            <div class="gate-field">
                <label class="gate-label" for="reply-subject">Subject</label>
                <input class="gate-input" id="reply-subject" @bind="_subject" />
            </div>
            <div class="gate-field">
                <label class="gate-label" for="reply-body">Body (corrected invoice fields re-enter intake)</label>
                <textarea class="gate-textarea" id="reply-body" rows="4" @bind="_body"></textarea>
            </div>
            <div class="gate-actions">
                <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitReplyAsync">Send reply</button>
                @if (_busy)
                {
                    <span class="gate-meta">Sending…</span>
                }
            </div>
            <OutcomeBox Outcome="@_replyOutcome" CaseId="@CaseOrNull()" />
        </section>
    }
</div>

@code {
    private const long MaxUploadBytes = 15L * 1024 * 1024;

    [Parameter]
    public string VendorId { get; set; } = string.Empty;

    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private SupplierPoList? _pos;
    private string? _posError;
    private bool _loadingPos;
    private string? _poNumber;

    private SupplierInboxVm? _inbox;
    private string? _inboxError;
    private bool _loading;
    private bool _busy;

    private string _confirmDate = string.Empty;
    private SimulationOutcome? _ackOutcome;

    private string _asnNumber = string.Empty;
    private string _slip = string.Empty;
    private readonly List<AsnRow> _asnCartons = [];
    private SimulationOutcome? _asnOutcome;

    private bool _photoMode;
    private string _invNumber = string.Empty;
    private string? _invVendor;
    private string? _invPo;
    private string _bankRef = string.Empty;
    private string? _uploadError;
    private SimulationOutcome? _invOutcome;
    private IReadOnlyList<PoLineOption> _poLines = [];
    private readonly List<InvRow> _invLines = [];
    private readonly List<UploadRow> _uploads = [];

    private string _from = string.Empty;
    private string? _inReplyTo;
    private string _subject = string.Empty;
    private string _body = string.Empty;
    private SimulationOutcome? _replyOutcome;
    private bool _extraSends;

    private bool ShowAck() =>
        _inbox is not null
        && (_inbox.NextAction == SupplierNextAction.Acknowledge
            || _inbox.NextAction == SupplierNextAction.Unknown);

    private bool ShowShip() =>
        _inbox is not null
        && (_inbox.NextAction == SupplierNextAction.Ship
            || _inbox.NextAction == SupplierNextAction.Unknown
            || (_extraSends && _inbox.NextAction == SupplierNextAction.Done));

    private bool ShowInvoice() =>
        _inbox is not null
        && (_inbox.NextAction == SupplierNextAction.Invoice
            || _inbox.NextAction == SupplierNextAction.Unknown
            || (_extraSends && _inbox.NextAction == SupplierNextAction.Done));

    private sealed class AsnRow
    {
        public string CartonId { get; set; } = string.Empty;
        public string ItemId { get; set; } = string.Empty;
        public int Units { get; set; }
        public string LotRef { get; set; } = string.Empty;
    }

    private sealed class InvRow
    {
        public string? PoLineRef { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
    }

    private sealed class UploadRow
    {
        public string FileName { get; set; } = string.Empty;
        public byte[] Bytes { get; set; } = [];
    }

    private string _loadedVendor = string.Empty;
    private SimulateOptions? _loadedOptions;
    private CompanyInfoDto? _company;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOptions is not null
            && ReferenceEquals(_loadedOptions, Options)
            && string.Equals(_loadedVendor, VendorId, StringComparison.Ordinal))
        {
            return;
        }

        _loadedVendor = VendorId;
        _loadedOptions = Options;
        _company = await Simulate.GetCompanyAsync();
        await LoadPosAsync();
    }

    private string? CaseOrNull() =>
        string.IsNullOrWhiteSpace(_inbox?.CaseId) ? null : _inbox.CaseId;

    // Company name from the runtime vendor master; the code shows only
    // when the master has no name for the id (never blank, never guessed).
    private string VendorNameFor(string vendorId) =>
        Options.Vendors.FirstOrDefault(v =>
            string.Equals(v.VendorId, vendorId, StringComparison.Ordinal))?.Name
        ?? vendorId;

    private async Task LoadPosAsync()
    {
        _loadingPos = true;
        _posError = null;
        _pos = null;
        _inbox = null;
        try
        {
            _pos = await Simulate.ListSupplierPosAsync(VendorId);
            if (string.IsNullOrWhiteSpace(_poNumber)
                || !_pos.Pos.Any(p => string.Equals(p.PoNumber, _poNumber, StringComparison.Ordinal)))
            {
                _poNumber = _pos.Pos.FirstOrDefault()?.PoNumber;
            }

            if (!string.IsNullOrWhiteSpace(_poNumber))
            {
                await LoadInboxAsync();
            }
        }
        catch (Exception ex)
        {
            _posError = $"Purchase orders for {VendorId} failed to load: {ex.Message}";
        }
        finally
        {
            _loadingPos = false;
        }
    }

    private async Task OnPoChanged(ChangeEventArgs e)
    {
        _poNumber = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(_poNumber))
        {
            await LoadInboxAsync();
        }
    }

    private async Task LoadInboxAsync()
    {
        _loading = true;
        _inboxError = null;
        _inbox = null;
        try
        {
            _inbox = await Simulate.GetSupplierInboxForPoAsync(_poNumber!);
            if (_inbox is null)
            {
                _inboxError = $"Purchase order {_poNumber} is not in the ERP.";
                return;
            }

            ApplyPrefill(_inbox);
        }
        catch (Exception ex)
        {
            _inboxError = $"Inbox for order {_poNumber} failed to load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyPrefill(SupplierInboxVm inbox)
    {
        _ackOutcome = null;
        _asnOutcome = null;
        _invOutcome = null;
        _replyOutcome = null;
        _extraSends = false;

        _asnNumber = inbox.AsnPrefill?.AsnNumber ?? string.Empty;
        _slip = inbox.AsnPrefill?.PackingSlipNumber ?? string.Empty;
        _asnCartons.Clear();
        if (inbox.AsnPrefill?.Cartons is { Count: > 0 } cartons)
        {
            foreach (var carton in cartons)
            {
                _asnCartons.Add(new AsnRow
                {
                    CartonId = carton.CartonId,
                    ItemId = carton.ItemId,
                    Units = carton.UnitsPerCarton,
                    LotRef = carton.LotRef,
                });
            }
        }
        else
        {
            _asnCartons.Add(new AsnRow());
        }

        _invNumber = inbox.InvoicePrefill?.Number ?? string.Empty;
        _invVendor = inbox.InvoicePrefill?.VendorId;
        _invPo = inbox.InvoicePrefill?.PoNumber;
        _invLines.Clear();
        if (inbox.InvoicePrefill?.Lines is { Count: > 0 } lines)
        {
            foreach (var line in lines)
            {
                _invLines.Add(new InvRow
                {
                    PoLineRef = line.PoLineRef,
                    Quantity = line.Quantity,
                    UnitPrice = line.UnitPrice,
                });
            }
        }
        else
        {
            _invLines.Add(new InvRow());
        }

        _ = RefreshPoLinesAsync();

        _from = inbox.Reply.From ?? string.Empty;
        _inReplyTo = inbox.Reply.InReplyTo;
        _subject = inbox.Reply.Subject ?? string.Empty;
    }

    private IReadOnlyList<string> PoChoices()
    {
        var numbers = new SortedSet<string>(StringComparer.Ordinal);
        if (!string.IsNullOrWhiteSpace(_poNumber))
        {
            numbers.Add(_poNumber);
        }

        if (_pos is not null)
        {
            foreach (var po in _pos.Pos)
            {
                numbers.Add(po.PoNumber);
            }
        }

        return numbers.ToList();
    }

    private async Task OnInvoicePoChanged(ChangeEventArgs e)
    {
        _invPo = e.Value?.ToString();
        await RefreshPoLinesAsync();
    }

    private async Task RefreshPoLinesAsync()
    {
        _poLines = string.IsNullOrWhiteSpace(_invPo)
            ? []
            : await Simulate.GetPoLinesAsync(_invPo);
        StateHasChanged();
    }

    private static decimal ParseDecimal(string? text) =>
        decimal.TryParse(text, out var value) ? value : 0m;

    private static int ParseInt(string? text) =>
        int.TryParse(text, out var value) ? value : 0;

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                using var stream = file.OpenReadStream(MaxUploadBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                _uploads.Add(new UploadRow { FileName = file.Name, Bytes = buffer.ToArray() });
            }
            catch (Exception ex)
            {
                _uploadError = $"Upload {file.Name} failed: {ex.Message}.";
            }
        }
    }

    private async Task SubmitAckAsync()
    {
        _busy = true;
        _ackOutcome = null;
        try
        {
            DateOnly? confirm = null;
            if (!string.IsNullOrWhiteSpace(_confirmDate)
                && DateOnly.TryParse(_confirmDate, out var parsed))
            {
                confirm = parsed;
            }

            _ackOutcome = await Simulate.SendAckAsync(_inbox?.CaseId, confirm);
            if (_ackOutcome.Ok)
            {
                var posted = _ackOutcome;
                await LoadInboxAsync();
                _ackOutcome = posted;
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _ackOutcome = new SimulationOutcome(false, $"Acknowledgement failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitAsnAsync()
    {
        _busy = true;
        _asnOutcome = null;
        try
        {
            _asnOutcome = await Simulate.SendAsnAsync(new AsnSubmission(
                _inbox?.CaseId ?? string.Empty,
                _asnNumber,
                _slip,
                _asnCartons.Select(c => new AsnCartonForm(c.CartonId, c.ItemId, c.Units, c.LotRef)).ToList()));
            if (_asnOutcome.Ok)
            {
                var posted = _asnOutcome;
                await LoadInboxAsync();
                _asnOutcome = posted;
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _asnOutcome = new SimulationOutcome(false, $"Shipment notice failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitInvoiceAsync()
    {
        _busy = true;
        _invOutcome = null;
        try
        {
            if (_photoMode)
            {
                var photos = _uploads
                    .Select(u => new SimulationPhoto(u.FileName, u.Bytes, null))
                    .ToList();
                _invOutcome = await Simulate.SendInvoicePhotosAsync(_inbox?.CaseId, photos);
            }
            else
            {
                var lines = _invLines
                    .Select(l => new InvoiceLineForm(l.PoLineRef, l.Quantity, l.UnitPrice))
                    .ToList();
                _invOutcome = await Simulate
                    .SendInvoiceAsync(_inbox?.CaseId, _invNumber, _invVendor, _invPo, lines, _bankRef);
            }

            if (_invOutcome.Ok)
            {
                var posted = _invOutcome;
                await LoadInboxAsync();
                _invOutcome = posted;
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _invOutcome = new SimulationOutcome(false, $"Invoice failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitReplyAsync()
    {
        _busy = true;
        _replyOutcome = null;
        try
        {
            var posted = await Simulate
                .SendVendorReplyAsync(_inbox?.CaseId, _from, _body, _subject, _inReplyTo);
            _replyOutcome = posted;
            if (posted.Ok)
            {
                _body = string.Empty;
                await LoadInboxAsync();
                _replyOutcome = posted;
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _replyOutcome = new SimulationOutcome(false, $"Reply failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
