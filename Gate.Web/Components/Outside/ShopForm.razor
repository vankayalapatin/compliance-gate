@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<section class="gate-card" id="shop">
    <div class="gate-card-head">
        <p class="gate-card-title">Customer shop</p>
        <div class="gate-card-badges">
            <span class="gate-chip">@Options.ScenarioName</span>
        </div>
    </div>
    <p class="gate-meta">You are the customer. Seeded orders start one case per shortfall item. A new shop order carries its own lines plus currency so the ERP mints the order.</p>
    <div class="gate-field">
        <label class="gate-label" for="order-so">Seeded order</label>
        <select class="gate-select" id="order-so" @onchange="OnSeededSoChanged">
            <option value="">— pick a seeded order —</option>
            @foreach (var so in Options.SoNumbers)
            {
                <option value="@so" selected="@(so == _soNumber && !_newOrder)">@so</option>
            }
        </select>
    </div>
    <label class="gate-checkline" for="order-new">
        <input type="checkbox" id="order-new" @bind="_newOrder" />
        New shop order (not a seeded one)
    </label>
    @if (_newOrder)
    {
        <div class="gate-field">
            <label class="gate-label" for="order-shopid">Shop order id</label>
            <input class="gate-input" id="order-shopid" @bind="_soNumber" placeholder="as the shop sent it" />
        </div>
        <div class="gate-field">
            <label class="gate-label" for="order-currency">Currency</label>
            <input class="gate-input" id="order-currency" @bind="_currency" />
        </div>
        <p class="gate-row"><span class="gate-label">Order lines</span></p>
        @foreach (var line in _lines)
        {
            <div class="gate-field">
                <select class="gate-select" value="@line.ItemId" @onchange="e => line.ItemId = e.Value?.ToString() ?? string.Empty">
                    <option value="">— item —</option>
                    @foreach (var item in Options.Items)
                    {
                        <option value="@item.ItemId">@item.ItemId@(string.IsNullOrEmpty(item.Unit) ? "" : $" ({item.Unit})")</option>
                    }
                </select>
                <input class="gate-input" type="number" min="0" step="any" value="@line.Quantity" @onchange="e => line.Quantity = ParseDecimal(e.Value?.ToString())" placeholder="quantity" />
                <div class="gate-actions">
                    <button class="gate-btn" disabled="@_busy" @onclick="() => _lines.Remove(line)">Remove</button>
                </div>
            </div>
        }
        <div class="gate-actions">
            <button class="gate-btn" disabled="@_busy" @onclick="() => _lines.Add(new OrderLineRow())">Add line</button>
        </div>
    }
    <div class="gate-field">
        <label class="gate-label" for="order-requester">Requester (blank uses the ERP default)</label>
        <select class="gate-select" id="order-requester" @bind="_requester">
            <option value="">— ERP default requester —</option>
            @foreach (var user in Options.Users)
            {
                <option value="@user.UserId">@user.UserId (@user.Role)</option>
            }
        </select>
    </div>
    <p class="gate-row"><span class="gate-label">Candidate vendors (from scenario):</span></p>
    @if (Options.CandidateVendorsByItem.Count == 0)
    {
        <p class="gate-meta">None in the scenario; the run proceeds without a candidate map.</p>
    }
    else
    {
        <ul class="gate-list">
            @foreach (var kv in Options.CandidateVendorsByItem.OrderBy(kv => kv.Key, StringComparer.Ordinal))
            {
                <li>@kv.Key ← @string.Join(", ", kv.Value)</li>
            }
        </ul>
    }
    <div class="gate-actions">
        <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="SubmitAsync">Place order</button>
        @if (_busy)
        {
            <span class="gate-meta">Sending…</span>
        }
    </div>
    <OutcomeBox Outcome="@_outcome" />
</section>

@code {
    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string _scenarioName = string.Empty;
    private string _soNumber = string.Empty;
    private string _currency = string.Empty;
    private string? _requester;
    private bool _newOrder;
    private bool _busy;
    private bool _prefilled;
    private SimulationOutcome? _outcome;
    private readonly List<OrderLineRow> _lines = [new()];

    private sealed class OrderLineRow
    {
        public string ItemId { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_scenarioName))
        {
            _scenarioName = Options.ScenarioName;
        }

        if (string.IsNullOrEmpty(_currency))
        {
            _currency = Options.Currency;
        }

        if (!_prefilled)
        {
            _prefilled = true;
            // One click: the first seeded order is already picked, and a new
            // shop order starts from the scenario order line.
            _soNumber = Options.SoNumbers.FirstOrDefault() ?? string.Empty;
            if (!string.IsNullOrEmpty(Options.SalesOrderItem)
                && Options.Items.Any(i => i.ItemId == Options.SalesOrderItem))
            {
                _lines[0].ItemId = Options.SalesOrderItem;
                _lines[0].Quantity = Options.SalesOrderQuantity;
            }
        }
    }

    private void OnSeededSoChanged(ChangeEventArgs e)
    {
        _soNumber = e.Value?.ToString() ?? string.Empty;
        _newOrder = false;
    }

    private static decimal ParseDecimal(string? text) =>
        decimal.TryParse(text, out var value) ? value : 0m;

    private async Task SubmitAsync()
    {
        _busy = true;
        _outcome = null;
        try
        {
            var submission = new OrderSubmission(
                _scenarioName,
                _soNumber,
                string.IsNullOrWhiteSpace(_requester) ? null : _requester,
                Options.CandidateVendorsByItem.Count == 0 ? null : Options.CandidateVendorsByItem,
                _newOrder ? _lines.Select(l => new OrderLineForm(l.ItemId, l.Quantity)).ToList() : null,
                _newOrder ? _currency : null);
            _outcome = await Simulate.SendOrderAsync(submission);
            if (_outcome.Ok)
            {
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _outcome = new SimulationOutcome(false, $"Placing the order failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
