@using Gate.Agent
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject AgentActivityService Activity
@inject PresentationPace Pace
@implements IDisposable

@if (_collapsed)
{
    <aside class="gate-activity rail" aria-label="Agent activity, collapsed">
        <button class="gate-btn gate-activity-expand" @onclick="() => _collapsed = false">Activity</button>
    </aside>
}
else
{
    <aside class="gate-activity" aria-label="Agent activity">
        <div class="gate-activity-head">
            <span class="gate-activity-title">Agent activity</span>
            <button class="gate-btn" @onclick="() => _collapsed = true">Hide</button>
        </div>
        @if (_model is null)
        {
            <p class="gate-meta">Loading activity…</p>
        }
        else
        {
            <p class="gate-activity-label">Now</p>
            <div class="gate-bubble-row agent">
                <div class="gate-bubble">@_model.Now</div>
            </div>
            <p class="gate-activity-label">Waiting on</p>
            @if (_model.Waiting.Count == 0)
            {
                <p class="gate-meta">No open orders.</p>
            }
            @foreach (var row in _model.Waiting)
            {
                <div class="gate-bubble-row agent">
                    <div class="gate-bubble"><a href="@row.Href">@row.Text</a></div>
                </div>
            }
            <p class="gate-activity-label">Recent</p>
            @if (_model.Recent.Count == 0)
            {
                <p class="gate-meta">Nothing yet.</p>
            }
            @foreach (var group in _model.Recent)
            {
                <p class="gate-case-group"><a href="@group.CaseHref">@group.HeaderText</a></p>
                @foreach (var line in group.Lines)
                {
                    <div class="gate-bubble-row @(line.Side == ActivitySide.Person ? "person" : "agent")">
                        <div class="gate-bubble @(line.Refused ? "refused" : "")">
                            @line.Text
                            @if (!string.Equals(line.Href, group.CaseHref, StringComparison.Ordinal))
                            {
                                <span> <a href="@line.Href">See purchase history</a></span>
                            }
                        </div>
                        <p class="gate-bubble-time">@ActivityLines.Stamp(line.At)</p>
                    </div>
                }
            }
        }
    </aside>
}

@code {
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan PaceRefreshEvery = TimeSpan.FromSeconds(1);

    private AgentActivityVm? _model;
    private bool _collapsed;
    private PeriodicTimer? _timer;
    private TimeSpan _interval = RefreshEvery;
    private CancellationTokenSource? _cts;
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _cts = new CancellationTokenSource();
        _interval = Pace.IsOn ? PaceRefreshEvery : RefreshEvery;
        _timer = new PeriodicTimer(_interval);
        _loop = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                await ReloadAsync();
                await InvokeAsync(StateHasChanged);
                // Presentation pace only: poll every second while the Admin
                // toggle is on so each step appears as it happens; off is
                // the usual five seconds. Timing only, nothing else.
                var want = Pace.IsOn ? PaceRefreshEvery : RefreshEvery;
                if (want != _interval)
                {
                    _interval = want;
                    _timer.Dispose();
                    _timer = new PeriodicTimer(want);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _model = await Activity.BuildAsync();
        }
        catch (Exception)
        {
            // Keep the last good render; the service already degrades
            // single failures to placeholder lines, so reaching here means
            // something unexpected. Never break the page for the pane.
            _model ??= new AgentActivityVm("Idle", [], []);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}
