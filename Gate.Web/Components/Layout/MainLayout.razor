@inherits LayoutComponentBase

<header class="gate-topbar">
    <a class="gate-brand" href="">ComplianceGate</a>
    <EntityHeader @rendermode="InteractiveServer" />
    <nav class="gate-nav" aria-label="Primary">
        <NavLink href="" Match="NavLinkMatch.All">Decisions</NavLink>
        <NavLink href="cases">Cases</NavLink>
        <NavLink href="erp">ERP</NavLink>
        <NavLink href="governance">Governance</NavLink>
        <NavLink href="admin">Admin</NavLink>
    </nav>
    <div class="gate-topbar-right">
        <a class="gate-outside-btn" href="outside" title="The other side: customer shop, supplier inbox, dock camera">Outside world &#8594;</a>
        <span class="gate-topbar-sep" aria-hidden="true"></span>
        <UserSwitcher @rendermode="InteractiveServer" />
    </div>
</header>

<main class="gate-main">
    @Body
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
