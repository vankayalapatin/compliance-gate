@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject ReplayService Replay
@inject ReplayState State
@inject ModelSpendTracker Spend
@inject ILogger<ReplayControls> Log

<div class="gate-replay">
    @if (State.IsReplay)
    {
        <span class="gate-badge gate-badge-dark" title="Offline answers on — zero live calls">Offline answers</span>
    }
    else
    {
        <span class="gate-badge">Live answers</span>
    }
    <span class="gate-badge" title="Model spend this session (live calls only; cached answers are free)">@Spend.Summary</span>
    @if (!_confirming)
    {
        <button class="gate-btn" disabled="@_busy" @onclick="() => _confirming = true">Restore saved data</button>
    }
    else
    {
        <span class="gate-meta">Restore the saved opening data? Current changes are discarded.</span>
        <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="RestoreAsync">Confirm restore</button>
        <button class="gate-btn" disabled="@_busy" @onclick="() => _confirming = false">Cancel</button>
    }
    @if (State.IsReplay)
    {
        <button class="gate-btn" disabled="@_busy" @onclick="ExitReplay">Use live answers</button>
    }
    else
    {
        <button class="gate-btn" disabled="@_busy" @onclick="EnterReplay">Use offline answers</button>
    }
    @if (_busy)
    {
        <span class="gate-meta">Working…</span>
    }
    else if (_summary is not null)
    {
        <span class="gate-meta" title="@_full">@_summary</span>
    }
</div>

@code {
    private bool _confirming;
    private bool _busy;
    private string? _summary;
    private string? _full;

    private void EnterReplay()
    {
        Replay.EnterReplay();
        _summary = "Offline answers on: Ask-why answers from the model cache only.";
        _full = _summary;
    }

    private void ExitReplay()
    {
        Replay.ExitReplay();
        _summary = "Live answers: model calls allowed.";
        _full = _summary;
    }

    private async Task RestoreAsync()
    {
        _busy = true;
        _summary = null;
        _full = null;
        try
        {
            // Progress posts back to the captured sync context; the render
            // still marshals through InvokeAsync per the service-event rule.
            var progress = new Progress<string>(step =>
            {
                _ = InvokeAsync(() =>
                {
                    // Late posts must not clobber the final report: only
                    // movement while the restore is still busy applies.
                    if (_busy)
                    {
                        _summary = step;
                        StateHasChanged();
                    }
                });
            });
            var report = await Replay.RestoreAsync(progress);
            _confirming = false;
            _full = report.Error ?? string.Join(" | ", report.Steps.Concat(report.Warnings));
            _summary = report.Error is not null
                ? "Restore failed."
                : $"Restore done ({report.Steps.Count} steps).";
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Restore failed.");
            _summary = "Restore failed.";
            _full = ex.Message;
            _confirming = false;
        }
        finally
        {
            _busy = false;
        }
    }
}
