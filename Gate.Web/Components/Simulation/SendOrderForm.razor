@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<div class="card mb-4" id="order">
    <div class="card-header"><strong>Send an order</strong> <span class="text-muted">POST /simulation/shopify/order</span></div>
    <div class="card-body">
        <p class="card-text text-muted">Seeded orders match the pre-seeded SO and start one case per shortfall item. A new shop order id carries its own lines plus currency so the ERP mints the SO. Candidate vendors come from the scenario vendors.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="order-scenario">Scenario</label>
                <input class="form-control" id="order-scenario" @bind="_scenarioName" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="order-so">Seeded SO</label>
                <select class="form-select" id="order-so" @onchange="OnSeededSoChanged">
                    <option value="">— pick a seeded order —</option>
                    @foreach (var so in Options.SoNumbers)
                    {
                        <option value="@so" selected="@(so == _soNumber && !_newOrder)">@so</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="order-new" @bind="_newOrder" />
                    <label class="form-check-label" for="order-new">New shop order (not a seeded SO)</label>
                </div>
            </div>
        </div>
        @if (_newOrder)
        {
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label" for="order-shopid">Shop order id</label>
                    <input class="form-control" id="order-shopid" @bind="_soNumber" placeholder="as the shop sent it" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="order-currency">Currency</label>
                    <input class="form-control" id="order-currency" @bind="_currency" />
                </div>
            </div>
            <h6 class="mt-3">Order lines</h6>
            @foreach (var line in _lines)
            {
                <div class="row g-2 mb-2">
                    <div class="col-md-5">
                        <select class="form-select" value="@line.ItemId" @onchange="e => line.ItemId = e.Value?.ToString() ?? string.Empty">
                            <option value="">— item —</option>
                            @foreach (var item in Options.Items)
                            {
                                <option value="@item.ItemId">@item.ItemId@(string.IsNullOrEmpty(item.Unit) ? "" : $" ({item.Unit})")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input class="form-control" type="number" min="0" step="any" value="@line.Quantity" @onchange="e => line.Quantity = ParseDecimal(e.Value?.ToString())" placeholder="quantity" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-danger" disabled="@_busy" @onclick="() => _lines.Remove(line)">Remove</button>
                    </div>
                </div>
            }
            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => _lines.Add(new OrderLineRow())">Add line</button>
        }
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label" for="order-requester">Requester (ERP user; blank uses the ERP default)</label>
                <select class="form-select" id="order-requester" @bind="_requester">
                    <option value="">— ERP default requester —</option>
                    @foreach (var user in Options.Users)
                    {
                        <option value="@user.UserId">@user.UserId (@user.Role)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Candidate vendors (from scenario)</label>
                @if (Options.CandidateVendorsByItem.Count == 0)
                {
                    <p class="text-muted mb-0">None in the scenario; the run proceeds without a candidate map.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var kv in Options.CandidateVendorsByItem.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                        {
                            <li>@kv.Key ← @string.Join(", ", kv.Value)</li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync">Send order</button>
            @if (_busy)
            {
                <span class="ms-2 text-muted">Sending…</span>
            }
        </div>
        @if (_outcome is not null)
        {
            <div class="mt-3">
                <ErrorBox Message="@(_outcome.Ok ? null : _outcome.Summary)" />
                @if (_outcome.Ok)
                {
                    <div class="alert alert-success" role="alert">@_outcome.Summary</div>
                }
                <ul>
                    @foreach (var detail in _outcome.Details)
                    {
                        <li>@detail</li>
                    }
                </ul>
                @foreach (var caseId in _outcome.CaseIds)
                {
                    <a class="btn btn-outline-primary btn-sm me-2" href="cases/@caseId">Open @caseId</a>
                }
                @if (_outcome.CaseIds.Count > 0)
                {
                    <a class="btn btn-outline-primary btn-sm" href="decisions">Open Decisions</a>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string _scenarioName = string.Empty;
    private string _soNumber = string.Empty;
    private string _currency = string.Empty;
    private string? _requester;
    private bool _newOrder;
    private bool _busy;
    private SimulationOutcome? _outcome;
    private readonly List<OrderLineRow> _lines = [new()];

    private sealed class OrderLineRow
    {
        public string ItemId { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_scenarioName))
        {
            _scenarioName = Options.ScenarioName;
        }

        if (string.IsNullOrEmpty(_currency))
        {
            _currency = Options.Currency;
        }
    }

    private void OnSeededSoChanged(ChangeEventArgs e)
    {
        _soNumber = e.Value?.ToString() ?? string.Empty;
        _newOrder = false;
    }

    private static decimal ParseDecimal(string? text) =>
        decimal.TryParse(text, out var value) ? value : 0m;

    private async Task SubmitAsync()
    {
        _busy = true;
        _outcome = null;
        try
        {
            var submission = new OrderSubmission(
                _scenarioName,
                _soNumber,
                string.IsNullOrWhiteSpace(_requester) ? null : _requester,
                Options.CandidateVendorsByItem.Count == 0 ? null : Options.CandidateVendorsByItem,
                _newOrder ? _lines.Select(l => new OrderLineForm(l.ItemId, l.Quantity)).ToList() : null,
                _newOrder ? _currency : null);
            _outcome = await Simulate.SendOrderAsync(submission).ConfigureAwait(false);
            if (_outcome.Ok)
            {
                await OnChanged.InvokeAsync().ConfigureAwait(false);
            }
        }
        catch (Exception ex)
        {
            _outcome = new SimulationOutcome(false, $"Send order failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
