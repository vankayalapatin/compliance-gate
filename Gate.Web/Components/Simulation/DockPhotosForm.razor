@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Simulate

<div class="card mb-4" id="dock">
    <div class="card-header"><strong>Upload dock photos</strong> <span class="text-muted">POST /simulation/dock/photos · /simulation/dock/reshot</span></div>
    <div class="card-body">
        <p class="card-text text-muted">Camera images in, reads out: Spark transcribes (cached by image hash) and C# judges. Send server dock images, uploaded files, or both. A reshot covers the picked cartons only.</p>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="dock-case">Case</label>
                <select class="form-select" id="dock-case" @bind="_caseId">
                    <option value="">— pick a case —</option>
                    @foreach (var kase in Options.Cases)
                    {
                        <option value="@kase.CaseId">@kase.CaseId (SO @kase.SoNumber · @kase.ItemId · @kase.Stage)</option>
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dock-reshot" @bind="_reshot" />
                    <label class="form-check-label" for="dock-reshot">Reshot (follow-up reads for picked cartons)</label>
                </div>
            </div>
        </div>
        @if (_reshot)
        {
            <label class="form-label mt-3">Cartons covered (from scenario)</label>
            @if (Options.CartonIds.Count == 0)
            {
                <p class="text-muted">No carton ids in the scenario; a reshot needs at least one.</p>
            }
            <div>
                @foreach (var carton in Options.CartonIds)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="reshot-@carton"
                               checked="@_cartons.Contains(carton, StringComparer.Ordinal)"
                               @onchange="e => ToggleCarton(carton, e.Value is true)" />
                        <label class="form-check-label" for="reshot-@carton">@carton</label>
                    </div>
                }
            </div>
        }
        <h6 class="mt-3">Server dock images</h6>
        @if (Options.DockImages.Count == 0)
        {
            <p class="text-muted">No dock images on the server; upload files below.</p>
        }
        @foreach (var image in Options.DockImages)
        {
            <div class="row g-2 align-items-center mb-2">
                <div class="col-md-5">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="dockimg-@image"
                               checked="@IsPicked(image)"
                               @onchange="e => ToggleServerImage(image, e.Value is true)" />
                        <label class="form-check-label" for="dockimg-@image">@image</label>
                    </div>
                    <img src="dock-images/@image" alt="@image" class="img-thumbnail mt-1" style="max-width: 240px;" />
                </div>
                <div class="col-md-4">
                    <select class="form-select" value="@HintFor(image)" @onchange="e => SetHint(image, e.Value?.ToString())" disabled="@(!IsPicked(image))">
                        <option value="">— no carton hint —</option>
                        @foreach (var carton in Options.CartonIds)
                        {
                            <option value="@carton">@carton</option>
                        }
                    </select>
                </div>
            </div>
        }
        <h6 class="mt-3">Upload files</h6>
        <InputFile multiple accept=".jpg,.jpeg" OnChange="OnUploadAsync" />
        @foreach (var row in _uploads)
        {
            <div class="row g-2 align-items-center mb-2 mt-2">
                <div class="col-md-5">
                    <span>@row.FileName (@row.Bytes.Length bytes)</span>
                    <button class="btn btn-outline-danger btn-sm ms-2" disabled="@_busy" @onclick="() => _uploads.Remove(row)">Remove</button>
                </div>
                <div class="col-md-4">
                    <select class="form-select" @bind="row.CartonHint">
                        <option value="">— no carton hint —</option>
                        @foreach (var carton in Options.CartonIds)
                        {
                            <option value="@carton">@carton</option>
                        }
                    </select>
                </div>
            </div>
        }
        <div class="mt-3">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync">@(_reshot ? "Send reshot" : "Send dock photos")</button>
            @if (_busy)
            {
                <span class="ms-2 text-muted">Transcribing and judging…</span>
            }
        </div>
        @if (_uploadError is not null)
        {
            <div class="mt-3"><ErrorBox Message="@_uploadError" /></div>
        }
        @if (_outcome is not null)
        {
            <div class="mt-3">
                <ErrorBox Message="@(_outcome.Ok ? null : _outcome.Summary)" />
                @if (_outcome.Ok)
                {
                    <div class="alert alert-success" role="alert">@_outcome.Summary</div>
                }
                <ul>
                    @foreach (var detail in _outcome.Details)
                    {
                        <li>@detail</li>
                    }
                </ul>
                @if (!string.IsNullOrEmpty(_caseId))
                {
                    <a class="btn btn-outline-primary btn-sm me-2" href="cases/@_caseId">Open @_caseId</a>
                    <a class="btn btn-outline-primary btn-sm" href="decisions">Open Decisions</a>
                }
            </div>
        }
    </div>
</div>

@code {
    private const long MaxUploadBytes = 15L * 1024 * 1024;

    [Parameter]
    public SimulateOptions Options { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string? _caseId;
    private bool _reshot;
    private bool _busy;
    private SimulationOutcome? _outcome;
    private string? _uploadError;
    private readonly HashSet<string> _cartons = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _serverPicks = new(StringComparer.Ordinal);
    private readonly List<UploadRow> _uploads = [];

    private sealed class UploadRow
    {
        public string FileName { get; set; } = string.Empty;
        public byte[] Bytes { get; set; } = [];
        public string? CartonHint { get; set; }
    }

    private bool IsPicked(string image) => _serverPicks.ContainsKey(image);

    private string HintFor(string image) =>
        _serverPicks.TryGetValue(image, out var hint) ? hint ?? string.Empty : string.Empty;

    private void SetHint(string image, string? hint)
    {
        if (_serverPicks.ContainsKey(image))
        {
            _serverPicks[image] = string.IsNullOrWhiteSpace(hint) ? null : hint;
        }
    }

    private void ToggleServerImage(string image, bool picked)
    {
        if (picked)
        {
            _serverPicks.TryAdd(image, null);
        }
        else
        {
            _serverPicks.Remove(image);
        }
    }

    private void ToggleCarton(string carton, bool picked)
    {
        if (picked)
        {
            _cartons.Add(carton);
        }
        else
        {
            _cartons.Remove(carton);
        }
    }

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        _uploadError = null;
        foreach (var file in e.GetMultipleFiles())
        {
            try
            {
                using var stream = file.OpenReadStream(MaxUploadBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                _uploads.Add(new UploadRow { FileName = file.Name, Bytes = buffer.ToArray() });
            }
            catch (Exception ex)
            {
                _uploadError = $"Upload {file.Name} failed: {ex.Message}.";
            }
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _outcome = null;
        try
        {
            var photos = new List<SimulationPhoto>();
            foreach (var pick in _serverPicks)
            {
                var (bytes, error) = await Simulate.TryReadDockImageAsync(pick.Key);
                if (bytes is null)
                {
                    _outcome = new SimulationOutcome(false, error ?? $"Dock image {pick.Key} is not available.", [], []);
                    return;
                }

                photos.Add(new SimulationPhoto(pick.Key, bytes, pick.Value));
            }

            photos.AddRange(_uploads.Select(u => new SimulationPhoto(u.FileName, u.Bytes, u.CartonHint)));

            _outcome = _reshot
                ? await Simulate.SendReshotAsync(_caseId, _cartons.ToList(), photos)
                : await Simulate.SendDockPhotosAsync(_caseId, photos);
            if (_outcome.Ok)
            {
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _outcome = new SimulationOutcome(false, $"Dock photos failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
