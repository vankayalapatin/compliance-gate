@page "/outside"
@rendermode InteractiveServer
@using Gate.Web.Components.Outside
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Sim

<PageTitle>Outside world</PageTitle>

@if (_loadError is not null)
{
    <ErrorBox Message="@_loadError" />
}
else if (_options is null)
{
    <p class="gate-meta">Loading options…</p>
}
else
{
    <div class="gate-erp">
        <OutsideSidebar Vendors="@_options.Vendors" Selected="@_selected" Select="OnSelect" />
        <div class="gate-erp-body">
            <div class="gate-page-head">
                <div>
                    <p class="gate-page-title">Outside world</p>
                    <p class="gate-page-sub">The other side of the counter: the customer shop, one portal per supplier, and the dock.</p>
                </div>
                <div>
                    <button class="gate-btn" disabled="@_busy" @onclick="ReloadAsync">Reload options</button>
                    <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="PickupAsync">Pick up ERP work</button>
                </div>
            </div>
            @foreach (var note in _options.Notes)
            {
                <div class="gate-notice" role="alert">@note</div>
            }
            @if (_pickup is not null)
            {
                <OutcomeBox Outcome="@_pickup" />
            }
            @if (_selected == "shop")
            {
                <ShopPanel Options="@_options" OnChanged="ReloadAsync" />
            }
            else if (_selected == "dock")
            {
                <DockPanel Options="@_options" OnChanged="ReloadAsync" />
            }
            else if (_selected.StartsWith("vendor:", StringComparison.Ordinal))
            {
                var vendorId = _selected["vendor:".Length..];
                <SupplierPortal VendorId="@vendorId" Options="@_options" OnChanged="ReloadAsync" />
            }
        </div>
    </div>
}

@code {
    private SimulateOptions? _options;
    private string? _loadError;
    private bool _busy;
    private string _selected = "shop";
    private SimulationOutcome? _pickup;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private void OnSelect(string selected)
    {
        _selected = selected;
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            _options = await Sim.GetOptionsAsync();
            _loadError = null;
            if (_selected.StartsWith("vendor:", StringComparison.Ordinal))
            {
                var vendorId = _selected["vendor:".Length..];
                if (!_options.Vendors.Any(v => string.Equals(v.VendorId, vendorId, StringComparison.Ordinal)))
                {
                    _selected = "shop";
                }
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Outside-world options failed to load: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PickupAsync()
    {
        _busy = true;
        try
        {
            _pickup = await Sim.PickUpErpWorkAsync(_options?.ScenarioName);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _pickup = new SimulationOutcome(false, $"ERP-work pickup failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
