@page "/demo"
@rendermode InteractiveServer
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject ReplayService Replay
@inject ReplayState State
@inject ILogger<Demo> Log

<PageTitle>Demo</PageTitle>

<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Demo</p>
        <p class="gate-page-sub">Reset to scenario start, then replay fully offline from the cache.</p>
    </div>
    <div>
        @if (State.IsReplay)
        {
            <span class="gate-badge gate-badge-dark">Replay mode on — zero live calls</span>
        }
        else
        {
            <span class="gate-badge">Live mode</span>
        }
    </div>
</div>

<section class="gate-card">
    <p class="gate-card-title">Reset + replay offline</p>
    <p class="gate-meta">Reloads the scenario, clears the case cache, and pins Ask-why to cached answers. Every step below runs locally; replay makes zero live calls.</p>
    <div class="gate-actions">
        <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="ResetAsync">Reset + replay offline</button>
        @if (_busy)
        {
            <span class="gate-meta">Working…</span>
        }
    </div>
    @if (_progress.Count > 0)
    {
        <ul class="gate-progress">
            @foreach (var step in _progress)
            {
                <li>@step</li>
            }
        </ul>
    }
    @if (_report is not null)
    {
        @if (_report.Error is not null)
        {
            <div class="gate-notice gate-notice-error" role="alert">@_report.Error</div>
        }
        @foreach (var warning in _report.Warnings)
        {
            <div class="gate-notice" role="alert">@warning</div>
        }
        <p class="gate-meta">Ran @_report.RanAtUtc.ToString("u") · replay @(_report.IsReplay ? "on" : "off") · zero live calls in replay.</p>
    }
</section>

@code {
    private bool _busy;
    private ReplayReport? _report;
    private readonly List<string> _progress = [];

    private async Task ResetAsync()
    {
        _busy = true;
        _report = null;
        _progress.Clear();
        try
        {
            // Progress<T> posts back to the captured sync context, and the
            // render still marshals through InvokeAsync per the service-event
            // rule: progress can fire from any thread the service uses.
            var progress = new Progress<string>(step =>
            {
                _ = InvokeAsync(() =>
                {
                    _progress.Add(step);
                    StateHasChanged();
                });
            });
            _report = await Replay.ResetAndReplayAsync(progress);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Reset + replay failed.");
            _report = new ReplayReport(DateTimeOffset.UtcNow, State.IsReplay, [], [], $"Reset + replay failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }
}
