@page "/cases"
@using Gate.Contracts
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject CaseCacheStore CaseStore

<PageTitle>Cases</PageTitle>

<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Cases</p>
        <p class="gate-page-sub">One order-to-payment chain per case. The dark step is the current stage.</p>
    </div>
</div>

@if (_loadError is not null)
{
    <ErrorBox Message="@_loadError" />
}
else if (_files is null)
{
    <p class="gate-meta">Loading cases…</p>
}
else if (_files.Count == 0)
{
    <p class="gate-meta">No cases yet. Place an order from the outside world.</p>
}
else
{
    @foreach (var file in _files)
    {
        var pending = file.Decisions.Count(d => d.Status == DecisionStatus.Pending);
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title"><a href="cases/@file.Case.CaseId">@CaseDisplay.DisplayName(file.Case)</a></p>
                <div class="gate-card-badges">
                    <span class="gate-badge">@file.Case.Stage</span>
                    @if (file.Case.IsOpeningData)
                    {
                        <span class="gate-chip">opening data</span>
                    }
                    @if (pending > 0)
                    {
                        <span class="gate-badge gate-badge-dark">@pending pending</span>
                    }
                </div>
            </div>
            <p class="gate-meta">@file.Case.CaseId · SO @file.Case.SoNumber · item @file.Case.ItemId</p>
            <ChainStrip Steps="@CaseChain.Strip(file.Case)" />
            @if (file.Case.BlockedByRuleId is null)
            {
                <p class="gate-meta">Not blocked.</p>
            }
            else
            {
                <div class="gate-notice" role="alert">Blocked by rule <strong>@file.Case.BlockedByRuleId</strong>: @(file.Case.BlockedReason ?? "—")</div>
            }
        </section>
    }
}

@code {
    private IReadOnlyList<CaseFile>? _files;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Real agent runs only: opening-data shells stay out of the list.
            _files = (await CaseStore.ListAsync())
                .Where(f => !f.Case.IsOpeningData)
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Cases failed to load: {ex.Message}";
        }
    }
}
