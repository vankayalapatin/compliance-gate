@page "/governance/memos"
@rendermode InteractiveServer
@using Gate.Agent
@using Gate.Compliance
@using Gate.Contracts
@using Gate.Web.Components.Governance
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject PolicyViewService Views
@inject PolicyOutcomeService Outcomes
@inject MemoSubmitService MemoSubmit
@inject CaseViewService UsersSvc
@inject KbViewService Kb
@inject ActingUserState Acting
@inject ILogger<GovernanceMemos> Log
@implements IDisposable

<PageTitle>Governance — Memos</PageTitle>

<div class="gate-erp">
    <GovernanceSidebar CurrentKey="@GovernanceModules.MemosSlug" Spaces="@_spaces" />
    <div class="gate-erp-body">
<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Memos</p>
        <p class="gate-page-sub">@Subtitle()</p>
    </div>
    <div>
        <button class="gate-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </div>
</div>

<section class="gate-card">
    <p class="gate-card-title">New memo</p>
    <p class="gate-meta">Paste a board memo or upload a text file. Intake runs it into a Spark proposal through the memo runner; the proposal, its questions, or the refusal shows below, and new cards join the lists.</p>
    <div class="gate-field">
        <label class="gate-label" for="memo-author">Author</label>
        <input class="gate-input" id="memo-author" @bind="_memoAuthor" />
    </div>
    <div class="gate-field">
        <label class="gate-label" for="memo-text">Memo text</label>
        <textarea class="gate-textarea" id="memo-text" rows="6" @bind="_memoText"></textarea>
    </div>
    <div class="gate-field">
        <label class="gate-label" for="memo-file">Upload a file instead (replaces the pasted text)</label>
        <div><InputFile id="memo-file" accept=".txt,.md,.text,.markdown" OnChange="OnMemoFileAsync" /></div>
        @if (_memoFileName is not null)
        {
            <p class="gate-meta">@_memoFileName loaded into the memo text.</p>
        }
    </div>
    <div class="gate-actions">
        <button class="gate-btn gate-btn-primary" disabled="@_memoBusy" @onclick="SubmitMemoAsync">Submit memo</button>
        @if (_memoBusy)
        {
            <span class="gate-meta">Drafting the proposal…</span>
        }
    </div>
    @if (_memoError is not null)
    {
        <ErrorBox Message="@_memoError" />
    }
    @if (_memoResult is not null)
    {
        @if (!_memoResult.Ok)
        {
            <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @_memoResult.Error</div>
        }
        else
        {
            <p class="gate-row"><span class="gate-label">Memo @_memoResult.MemoId</span> — @_memoResult.Summary</p>
            @if (_memoResult.Statements.Count > 0)
            {
                <p class="gate-row"><span class="gate-label">Spark interpretation:</span></p>
                <ul class="gate-list">
                    @foreach (var statement in _memoResult.Statements)
                    {
                        <li>@statement</li>
                    }
                </ul>
            }
            @if (_memoResult.Questions.Count > 0)
            {
                <p class="gate-row"><span class="gate-label">Open questions:</span></p>
                <ul class="gate-list">
                    @foreach (var question in _memoResult.Questions)
                    {
                        <li>@question</li>
                    }
                </ul>
            }
            @if (_memoResult.ValidationErrors.Count > 0)
            {
                <div class="gate-notice gate-notice-error" role="alert">
                    <strong>Validation refuses (@CountWords(_memoResult.ValidationErrors.Count, "error")):</strong>
                    <ul class="gate-list">
                        @foreach (var error in _memoResult.ValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
        }
    }
</section>

@if (_loadError is not null)
{
    <ErrorBox Message="@_loadError" />
}
else if (_questions is null || _approvals is null || _activations is null || _users is null || _delegations is null)
{
    <p class="gate-meta">Loading memos…</p>
}
else if (_selected is null)
{
    <div class="gate-notice gate-notice-error" role="alert">ERP has no users, so there is nobody to act as.</div>
}
else
{
    <section class="gate-card">
        <p class="gate-card-title">Pending questions for @_selected (@_pendingQuestions.Count)</p>
        @if (_pendingQuestions.Count == 0)
        {
            <p class="gate-meta">No pending policy questions for @_selected.</p>
        }
    </section>
    @foreach (var card in _pendingQuestions)
    {
        var d = card.Decision;
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">@d.Title</p>
                <div class="gate-card-badges">
                    @if (_covering.Count > 0)
                    {
                        <span class="gate-chip">covering @(string.Join(", ", _covering))</span>
                    }
                    <span class="gate-badge">Policy question</span>
                    @if (card.Question is not null)
                    {
                        <span class="gate-badge">@(card.Question.Blocking ? "Blocking — memo waits" : "Advisory")</span>
                    }
                    <span class="gate-badge gate-badge-dark">Pending</span>
                </div>
            </div>
            <p class="gate-meta">
                Memo @card.MemoId · requested to @ActorLabels.Display(d.RequestedTo) at @ErpFormat.When(d.RequestedAt)@if (d.DocumentNumber is not null)
                {
                    <span> · ref @d.DocumentNumber</span>
                }
            </p>
            @if (d.Amount is not null)
            {
                <p class="gate-row"><span class="gate-label">Amount:</span> @ErpFormat.Money(d.Amount.Value, d.Currency)</p>
            }
            @if (card.Question is not null)
            {
                <p class="gate-row"><span class="gate-label">Question [@card.Question.QuestionId]:</span> @card.Question.Question</p>
            }
            else if (d.Reason is not null)
            {
                <p class="gate-row"><span class="gate-label">Question (from decision card):</span> @d.Reason</p>
            }
            @if (card.Notices.Count > 0)
            {
                <ul class="gate-list">
                    @foreach (var notice in card.Notices)
                    {
                        <li>@notice</li>
                    }
                </ul>
            }
            @if (card.Options.Count > 0)
            {
                <div class="gate-field">
                    <span class="gate-label">Offered options</span>
                    @foreach (var option in card.Options)
                    {
                        var opt = option;
                        <label class="gate-checkline" for="opt-@d.DecisionId-@opt">
                            <input type="radio" name="opt-@d.DecisionId" id="opt-@d.DecisionId-@opt"
                                   checked="@(ChosenOptionFor(d.DecisionId) == opt)"
                                   @onchange="() => _chosenOptions[d.DecisionId] = opt" />
                            @opt
                        </label>
                    }
                </div>
                @if (!card.OptionsVerified)
                {
                    <p class="gate-meta">Options from the card's evidence refs, unverified against a proposal round.</p>
                }
                <div class="gate-actions">
                    <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="() => AnswerAsync(card)">Answer</button>
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="decline-@d.DecisionId">Decline note (recorded on decline)</label>
                    <input class="gate-input" id="decline-@d.DecisionId"
                           value="@DeclineNoteFor(d.DecisionId)" @onchange="e => _declineNotes[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="gate-actions">
                    <button class="gate-btn" disabled="@_busy" @onclick="() => DeclineAsync(card)">Decline (closes the memo)</button>
                </div>
            }
            @if (_outcomes.TryGetValue(d.DecisionId, out var outcome))
            {
                @if (outcome.Ok)
                {
                    <div class="gate-notice gate-notice-ok" role="alert">@outcome.Message</div>
                }
                else
                {
                    <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @outcome.Message</div>
                }
                @foreach (var warning in outcome.Warnings)
                {
                    <div class="gate-notice" role="alert">@warning</div>
                }
            }
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Pending approvals for @_selected (@_pendingApprovals.Count)</p>
        @if (_pendingApprovals.Count == 0)
        {
            <p class="gate-meta">No pending policy approvals for @_selected.</p>
        }
    </section>
    @foreach (var card in _pendingApprovals)
    {
        var d = card.Decision;
        var current = card.Current;
        var proposal = current?.Proposal;
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">@d.Title</p>
                <div class="gate-card-badges">
                    @if (_covering.Count > 0)
                    {
                        <span class="gate-chip">covering @(string.Join(", ", _covering))</span>
                    }
                    <span class="gate-badge">Policy approval</span>
                    <AgentBanner Source="@RecordSource.P2pAgent" />
                    @if (card.StaleCard)
                    {
                        <span class="gate-badge gate-badge-dark">stale</span>
                    }
                    <span class="gate-badge gate-badge-dark">@ErpStatusWords.Of(d.Status)</span>
                </div>
            </div>
            <p class="gate-meta">
                Memo @card.MemoId · policy owner @card.PolicyOwner
                · requested to @ActorLabels.Display(d.RequestedTo) at @ErpFormat.When(d.RequestedAt)
            </p>
            @if (d.Amount is not null)
            {
                <p class="gate-row"><span class="gate-label">Amount:</span> @ErpFormat.Money(d.Amount.Value, d.Currency)</p>
            }
            <p class="gate-row"><span class="gate-label">Memo @card.Memo.MemoId</span> from @card.Memo.Author, received @ErpFormat.When(card.Memo.ReceivedAt)</p>
            <div class="gate-notice" role="note">@card.Memo.Excerpt</div>
            @if (proposal is not null && current is not null)
            {
                <p class="gate-row">
                    <span class="gate-label">Proposal @proposal.ProposalId</span>
                    · KB @KbDisplay.Version(proposal.KbVersion) · proposed @ErpFormat.When(proposal.ProposedAt)
                    · hash <code>@proposal.ProposalHash</code>
                </p>
                <p class="gate-row">
                    <span class="gate-label">Spark interpretation</span>
                    (@CountWords(proposal.Statements.Count, "statement"),
                    @(proposal.Statements.Count - card.UnresolvedStatements.Count) resolved,
                    @card.UnresolvedStatements.Count unresolved):
                </p>
                <ul class="gate-list">
                    @foreach (var s in proposal.Statements)
                    {
                        var resolved = PolicyLabels.IsResolved(s, proposal.Resolutions);
                        <li>
                            “@s.Quote” → @s.Interpretation
                            (confidence @s.Confidence)
                            <span class="gate-badge">@(resolved ? "resolved" : "unresolved")</span>
                        </li>
                    }
                </ul>
                @if (proposal.Resolutions.Count > 0)
                {
                    <p class="gate-row"><span class="gate-label">Resolved entities:</span></p>
                    <ul class="gate-list">
                        @foreach (var r in proposal.Resolutions)
                        {
                            <li>“@r.Phrase” → @r.EntityId (<a href="/@GovernanceRoutes.CitationHref(r.Citation)"><code>@PolicyLabels.Citation(r.Citation)</code></a>)</li>
                        }
                    </ul>
                }
                @if (proposal.Citations.Count > 0)
                {
                    <p class="gate-row">
                        <span class="gate-label">Citations:</span>
                        @foreach (var c in proposal.Citations)
                        {
                            <a href="/@GovernanceRoutes.CitationHref(c)"><code>@PolicyLabels.Citation(c)</code></a><span> </span>
                        }
                    </p>
                }
                @if (proposal.ProposedRule is not null)
                {
                    <p class="gate-row">
                        <span class="gate-label">Proposed rule:</span> @proposal.ProposedRule.RuleType
                        at the @proposal.ProposedRule.Gate gate
                    </p>
                    <ul class="gate-list">
                        @foreach (var kv in proposal.ProposedRule.Params.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                        {
                            <li><code>@kv.Key</code> = <code>@kv.Value</code></li>
                        }
                    </ul>
                }
                else if (proposal.NotMappable is not null)
                {
                    <div class="gate-notice gate-notice-error" role="alert">
                        <strong>NotMappable:</strong> nearest type @proposal.NotMappable.NearestType —
                        @proposal.NotMappable.WhyNot
                        (missing capability: @proposal.NotMappable.MissingCapability).
                        Approval is refused; rejecting closes the memo.
                    </div>
                }
                @if (proposal.Questions.Count > 0)
                {
                    <p class="gate-row"><span class="gate-label">Open questions:</span></p>
                    <ul class="gate-list">
                        @foreach (var q in proposal.Questions)
                        {
                            <li>
                                [@q.QuestionId] @(q.Blocking ? "blocking" : "advisory"): @q.Question@if (q.Options.Count > 0)
                                {
                                    <span> (options: @string.Join("; ", q.Options))</span>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (current.Validation.Ok)
                {
                    <div class="gate-notice gate-notice-ok" role="alert">Validation passed against the pinned KB.</div>
                }
                else
                {
                    <div class="gate-notice gate-notice-error" role="alert">
                        <strong>Validation refuses (@CountWords(current.Validation.Errors.Count, "error")):</strong>
                        <ul class="gate-list">
                            @foreach (var error in current.Validation.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                @if (current.Validation.Conflicts.Count > 0)
                {
                    <p class="gate-row"><span class="gate-label">Live-pack conflicts:</span></p>
                    <ul class="gate-list">
                        @foreach (var conflict in current.Validation.Conflicts)
                        {
                            <li><strong>@conflict.RuleId</strong> (@conflict.Kind): @conflict.Detail</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="gate-meta">No live-pack conflicts recorded.</p>
                }
                @if (current.WhatIf is not null)
                {
                    var report = current.WhatIf;
                    <p class="gate-row">
                        <span class="gate-label">What-if</span>
                        (@report.HistoryLabel; @CountWords(report.HistoryRowCount, "history row");
                        computed @ErpFormat.When(report.ComputedAt)):
                    </p>
                    @if (report.Unviable)
                    {
                        <div class="gate-notice gate-notice-error" role="alert"><strong>Unviable:</strong> no award path passes under the proposed rule.</div>
                    }
                    @if (report.Flips.Count > 0)
                    {
                        <ul class="gate-list">
                            @foreach (var flip in report.Flips)
                            {
                                <li>
                                    @flip.DocumentType @flip.DocumentNumber:
                                    @PolicyLabels.VerdictWords(flip.OldKind) → @PolicyLabels.VerdictWords(flip.NewKind)
                                    @(flip.BlockingRuleId is null ? "" : $"(blocked by {flip.BlockingRuleId})"),
                                    qty @ErpFormat.Qty(flip.Quantity), @PolicyLabels.FlipMoney(flip.Amount, flip.Currency)
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="gate-meta">No verdict flips.</p>
                    }
                    @if (report.PipelineRows.Count > 0)
                    {
                        <p class="gate-row"><span class="gate-label">Pipeline rows:</span></p>
                        <ul class="gate-list">
                            @foreach (var row in report.PipelineRows)
                            {
                                <li>
                                    @row.DocumentType @row.DocumentNumber:
                                    @PolicyLabels.VerdictWords(row.OldKind) → @PolicyLabels.VerdictWords(row.NewKind)
                                    @(row.BlockingRuleId is null ? "" : $"(blocked by {row.BlockingRuleId})")
                                </li>
                            }
                        </ul>
                    }
                    <p class="gate-row">
                        <span class="gate-label">Totals:</span> @report.Totals.DocumentsEvaluated evaluated,
                        @FlipWords(report.Totals.FlipsToBlock, "block"), @FlipWords(report.Totals.FlipsToPass, "pass"),
                        qty @ErpFormat.Qty(report.Totals.QuantityFlipped),
                        @PolicyLabels.TotalsMoney(report.Totals.AmountFlipped, report.Totals.Currency)
                    </p>
                }
            }
            <div class="gate-notice" role="note">
                <strong>Approval pin:</strong> @PolicyLabels.DecisionPin(d, proposal?.KbVersion)<br />
                @if (card.Activation is not null)
                {
                    <span>Published @card.Activation.RuleId in pack @card.Activation.PackId
                    @card.Activation.PriorPackVersion → @card.Activation.NewPackVersion,
                    effective @ErpFormat.When(card.Activation.EffectiveAt) · @PolicyLabels.ApplicabilityWords(card.Activation.Applicability).</span>
                }
            </div>
            @if (card.Notices.Count > 0)
            {
                <ul class="gate-list">
                    @foreach (var notice in card.Notices)
                    {
                        <li>@notice</li>
                    }
                </ul>
            }
            @if (proposal is not null)
            {
                <div class="gate-field">
                    <label class="gate-label" for="applic-@d.DecisionId">Applicability mode</label>
                    <select class="gate-select" id="applic-@d.DecisionId" value="@ApplicabilityFor(d.DecisionId)" @onchange="e => _applicability[d.DecisionId] = Enum.Parse<RuleApplicability>(e.Value?.ToString() ?? nameof(RuleApplicability.ProspectiveOnly))">
                        @foreach (var mode in Enum.GetValues<RuleApplicability>())
                        {
                            <option value="@mode">@PolicyLabels.ApplicabilityWords(mode)</option>
                        }
                    </select>
                    <p class="gate-meta">@PolicyLabels.ApplicabilityBlurb(ApplicabilityFor(d.DecisionId))</p>
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="effective-@d.DecisionId">Effective datetime (UTC, mandatory)</label>
                    <input class="gate-input" type="datetime-local" id="effective-@d.DecisionId"
                           value="@EffectiveFor(d.DecisionId)" @onchange="e => _effective[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                    <p class="gate-meta">Never backdated without a recorded reason in the comment.</p>
                </div>
                <div class="gate-field">
                    <label class="gate-label" for="comment-@d.DecisionId">Comment / reason</label>
                    <input class="gate-input" id="comment-@d.DecisionId"
                           value="@CommentFor(d.DecisionId)" @onchange="e => _comments[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                </div>
                @if (proposal.ProposedRule is not null)
                {
                    <p class="gate-row"><span class="gate-label">Parameters (registry: @proposal.ProposedRule.RuleType):</span></p>
                    @foreach (var key in ParamKeysFor(card))
                    {
                        var k = key;
                        var known = card.RuleSpec is not null
                            && (card.RuleSpec.RequiredParams.Contains(k) || card.RuleSpec.OptionalParams.Contains(k));
                        <div class="gate-field">
                            <label class="gate-label" for="param-@d.DecisionId-@k">
                                <code>@k</code>
                                @if (!known)
                                {
                                    <span class="gate-badge">not in registry</span>
                                }
                            </label>
                            <input class="gate-input" id="param-@d.DecisionId-@k"
                                   value="@ParamValueFor(card, k)" @onchange="e => SetParamValue(card, k, e.Value?.ToString() ?? string.Empty)" />
                        </div>
                    }
                    <p class="gate-meta">Blank optional values are omitted; the registry judges the rest. Unchanged params approve as proposed.</p>
                }
                @if (card.NeedsNewRuleSpec)
                {
                    <p class="gate-row"><span class="gate-label">New rule (no live rule to update): title, tier, and label are the approver's call.</span></p>
                    <div class="gate-field">
                        <label class="gate-label" for="title-@d.DecisionId">Title</label>
                        <input class="gate-input" id="title-@d.DecisionId"
                               value="@NewRuleTitleFor(d.DecisionId)" @onchange="e => _newRuleTitles[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="gate-field">
                        <label class="gate-label" for="tier-@d.DecisionId">Tier</label>
                        <select class="gate-select" id="tier-@d.DecisionId" value="@NewRuleTierFor(d.DecisionId)" @onchange="e => _newRuleTiers[d.DecisionId] = Enum.Parse<RuleTier>(e.Value?.ToString() ?? nameof(RuleTier.Tier2))">
                            @foreach (var tier in Enum.GetValues<RuleTier>())
                            {
                                <option value="@tier">@PolicyLabels.TierWords(tier)</option>
                            }
                        </select>
                    </div>
                    <div class="gate-field">
                        <label class="gate-label" for="doclabel-@d.DecisionId">Document label</label>
                        <input class="gate-input" id="doclabel-@d.DecisionId"
                               value="@NewRuleDocLabelFor(d.DecisionId)" @onchange="e => _newRuleDocLabels[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <p class="gate-meta">DocumentPresence rules require the document label; other types leave it blank.</p>
                }
                <div class="gate-field">
                    <label class="gate-label" for="evidence-@d.DecisionId">Test evidence (passing test names, one per line; required to approve)</label>
                    <textarea class="gate-textarea" id="evidence-@d.DecisionId" rows="2"
                              value="@EvidenceFor(d.DecisionId)" @onchange="e => _evidence[d.DecisionId] = e.Value?.ToString() ?? string.Empty"></textarea>
                </div>
                <div class="gate-actions">
                    <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="() => DecideAsync(card, true)">Approve</button>
                    <button class="gate-btn" disabled="@_busy" @onclick="() => DecideAsync(card, false)">Reject</button>
                </div>
            }
            @if (_outcomes.TryGetValue(d.DecisionId, out var outcome))
            {
                @if (outcome.Ok)
                {
                    <div class="gate-notice gate-notice-ok" role="alert">@outcome.Message</div>
                }
                else
                {
                    <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @outcome.Message</div>
                }
                @foreach (var warning in outcome.Warnings)
                {
                    <div class="gate-notice" role="alert">@warning</div>
                }
            }
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Decided by me (@(_historyQuestions.Count + _historyApprovals.Count))</p>
        @if (_historyQuestions.Count + _historyApprovals.Count == 0)
        {
            <p class="gate-meta">Nothing decided by @_selected yet.</p>
        }
        else
        {
            <table class="gate-table">
                <thead>
                    <tr><th>Decision</th><th>Memo</th><th>Kind</th><th>Outcome</th><th>Decided at</th><th>Comment</th></tr>
                </thead>
                <tbody>
                    @foreach (var card in _historyQuestions)
                    {
                        var h = card.Decision;
                        <tr>
                            <td>@h.Title</td>
                            <td>@card.MemoId</td>
                            <td>Policy question</td>
                            <td><span class="gate-badge @(h.Status == DecisionStatus.Approved ? "gate-badge-dark" : "")">@ErpStatusWords.Of(h.Status)</span></td>
                            <td>@(h.DecidedAt is null ? "—" : ErpFormat.When(h.DecidedAt.Value))</td>
                            <td>@(h.Comment ?? "—")</td>
                        </tr>
                    }
                    @foreach (var card in _historyApprovals)
                    {
                        var h = card.Decision;
                        <tr>
                            <td>@h.Title</td>
                            <td>@card.MemoId</td>
                            <td>Policy approval</td>
                            <td><span class="gate-badge @(h.Status == DecisionStatus.Approved ? "gate-badge-dark" : "")">@ErpStatusWords.Of(h.Status)</span></td>
                            <td>@(h.DecidedAt is null ? "—" : ErpFormat.When(h.DecidedAt.Value))</td>
                            <td>@(h.Comment ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="gate-card">
        <p class="gate-card-title">Activations (@_activations.Count)</p>
        @if (_activations.Count == 0)
        {
            <p class="gate-meta">No published activations yet.</p>
        }
    </section>
    @foreach (var activation in _activations)
    {
        var a = activation.Activation;
        <section class="gate-card" id="activation-@a.ActivationId">
            <div class="gate-card-head">
                <p class="gate-card-title">@a.PackId @a.NewPackVersion</p>
                <div class="gate-card-badges">
                    @if (_covering.Count > 0)
                    {
                        <span class="gate-chip">covering @(string.Join(", ", _covering))</span>
                    }
                    <span class="gate-badge">published</span>
                </div>
            </div>
            <p class="gate-row"><span class="gate-label">Source:</span> @activation.SourceLine</p>
            <p class="gate-row">
                <span class="gate-label">Rule:</span> @a.RuleId · memo @activation.MemoId ·
                prior version @a.PriorPackVersion (rollback point) ·
                effective @ErpFormat.When(a.EffectiveAt) · @PolicyLabels.ApplicabilityWords(a.Applicability) ·
                published @ErpFormat.When(a.PublishedAt) · proposal <code>@a.ProposalHash</code>
            </p>
            <div class="gate-field">
                <label class="gate-label" for="restore-@a.ActivationId">Version to restore</label>
                <input class="gate-input" id="restore-@a.ActivationId"
                       value="@RollbackRestoreFor(activation)" @onchange="e => _rollbackRestores[a.ActivationId] = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="gate-field">
                <label class="gate-label" for="rollback-@a.ActivationId">Rollback reason (required)</label>
                <input class="gate-input" id="rollback-@a.ActivationId"
                       value="@RollbackReasonFor(a.ActivationId)" @onchange="e => _rollbackReasons[a.ActivationId] = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="gate-actions">
                <button class="gate-btn" disabled="@_busy" @onclick="() => RollbackAsync(activation)">Request rollback as @_selected</button>
            </div>
            <p class="gate-meta">Rollback publishes a new pack version restoring the named version; history is untouched.</p>
            @if (_rollbackOutcomes.TryGetValue(a.ActivationId, out var outcome))
            {
                @if (outcome.Ok)
                {
                    <div class="gate-notice gate-notice-ok" role="alert">@outcome.Message</div>
                }
                else
                {
                    <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @outcome.Message</div>
                }
                @foreach (var warning in outcome.Warnings)
                {
                    <div class="gate-notice" role="alert">@warning</div>
                }
            }
        </section>
    }
}
    </div>
</div>

@code {
    private IReadOnlyList<PolicyQuestionCardVm>? _questions;
    private IReadOnlyList<PolicyApprovalCardVm>? _approvals;
    private IReadOnlyList<PolicyActivationVm>? _activations;
    private IReadOnlyList<UserDto>? _users;
    private IReadOnlyList<KbSpace> _spaces = [];
    private IReadOnlyList<DelegationDto>? _delegations;
    private IReadOnlyList<PolicyQuestionCardVm> _pendingQuestions = [];
    private IReadOnlyList<PolicyApprovalCardVm> _pendingApprovals = [];
    private IReadOnlyList<PolicyQuestionCardVm> _historyQuestions = [];
    private IReadOnlyList<PolicyApprovalCardVm> _historyApprovals = [];
    private IReadOnlyList<string> _covering = [];
    private const long MaxMemoUploadBytes = 256L * 1024;

    private string? _selected;
    private string? _loadError;
    private bool _busy;
    private string _memoAuthor = string.Empty;
    private string _memoText = string.Empty;
    private string? _memoFileName;
    private bool _memoBusy;
    private string? _memoError;
    private MemoSubmitResult? _memoResult;
    private readonly Dictionary<string, string> _chosenOptions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _declineNotes = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _effective = new(StringComparer.Ordinal);
    private readonly Dictionary<string, RuleApplicability> _applicability = new();
    private readonly Dictionary<string, string> _comments = new(StringComparer.Ordinal);
    private readonly Dictionary<string, Dictionary<string, string>> _paramEdits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _newRuleTitles = new(StringComparer.Ordinal);
    private readonly Dictionary<string, RuleTier> _newRuleTiers = new();
    private readonly Dictionary<string, string> _newRuleDocLabels = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _evidence = new(StringComparer.Ordinal);
    private readonly Dictionary<string, PolicyOutcome> _outcomes = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rollbackRestores = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rollbackReasons = new(StringComparer.Ordinal);
    private readonly Dictionary<string, PolicyOutcome> _rollbackOutcomes = new(StringComparer.Ordinal);

    private string ChosenOptionFor(string decisionId)
    {
        _chosenOptions.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string DeclineNoteFor(string decisionId)
    {
        _declineNotes.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string EffectiveFor(string decisionId)
    {
        _effective.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private RuleApplicability ApplicabilityFor(string decisionId) =>
        _applicability.TryGetValue(decisionId, out var value) ? value : RuleApplicability.ProspectiveOnly;

    private string CommentFor(string decisionId)
    {
        _comments.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string NewRuleTitleFor(string decisionId)
    {
        _newRuleTitles.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private RuleTier NewRuleTierFor(string decisionId) =>
        _newRuleTiers.TryGetValue(decisionId, out var value) ? value : RuleTier.Tier2;

    private string NewRuleDocLabelFor(string decisionId)
    {
        _newRuleDocLabels.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string EvidenceFor(string decisionId)
    {
        _evidence.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string RollbackRestoreFor(PolicyActivationVm activation)
    {
        if (_rollbackRestores.TryGetValue(activation.Activation.ActivationId, out var value))
        {
            return value;
        }

        return activation.Activation.PriorPackVersion;
    }

    private string RollbackReasonFor(string activationId)
    {
        _rollbackReasons.TryGetValue(activationId, out var value);
        return value ?? string.Empty;
    }

    private IReadOnlyList<string> ParamKeysFor(PolicyApprovalCardVm card)
    {
        var keys = new List<string>();
        if (card.RuleSpec is not null)
        {
            keys.AddRange(card.RuleSpec.RequiredParams);
            keys.AddRange(card.RuleSpec.OptionalParams);
        }

        if (card.Current?.Proposal.ProposedRule is not null)
        {
            foreach (var key in card.Current.Proposal.ProposedRule.Params.Keys.OrderBy(k => k, StringComparer.Ordinal))
            {
                if (!keys.Contains(key))
                {
                    keys.Add(key);
                }
            }
        }

        return keys;
    }

    private string ParamValueFor(PolicyApprovalCardVm card, string key)
    {
        if (_paramEdits.TryGetValue(card.Decision.DecisionId, out var edits)
            && edits.TryGetValue(key, out var edited))
        {
            return edited;
        }

        if (card.Current?.Proposal.ProposedRule?.Params.TryGetValue(key, out var proposed) == true)
        {
            return proposed;
        }

        return string.Empty;
    }

    private void SetParamValue(PolicyApprovalCardVm card, string key, string value)
    {
        if (!_paramEdits.TryGetValue(card.Decision.DecisionId, out var edits))
        {
            edits = new Dictionary<string, string>(StringComparer.Ordinal);
            _paramEdits[card.Decision.DecisionId] = edits;
        }

        edits[key] = value;
    }

    private IReadOnlyDictionary<string, string>? EditedParamsFor(PolicyApprovalCardVm card)
    {
        var keys = ParamKeysFor(card);
        if (keys.Count == 0)
        {
            return null;
        }

        var optional = card.RuleSpec?.OptionalParams ?? [];
        var map = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var key in keys)
        {
            var value = ParamValueFor(card, key).Trim();
            if (value.Length == 0 && optional.Contains(key))
            {
                continue;
            }

            map[key] = value;
        }

        return map;
    }

    private NewRuleSpec? NewRuleSpecFor(PolicyApprovalCardVm card)
    {
        if (!card.NeedsNewRuleSpec)
        {
            return null;
        }

        var title = NewRuleTitleFor(card.Decision.DecisionId).Trim();
        if (title.Length == 0)
        {
            return null;
        }

        var docLabel = NewRuleDocLabelFor(card.Decision.DecisionId).Trim();
        return new NewRuleSpec(title, NewRuleTierFor(card.Decision.DecisionId),
            docLabel.Length == 0 ? null : docLabel);
    }

    private IReadOnlyList<string> EvidenceLinesFor(string decisionId) =>
        EvidenceFor(decisionId)
            .Split('\n')
            .Select(line => line.Trim().TrimEnd('\r'))
            .Where(line => line.Length > 0)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Acting.OnChange += OnActingChanged;
        await ReloadAsync();
    }

    public void Dispose()
    {
        Acting.OnChange -= OnActingChanged;
    }

    private void OnActingChanged()
    {
        // ActingUserState.OnChange is a service-raised event: it can fire
        // from any thread, so the whole handler (state touches and render)
        // marshals to the Dispatcher.
        _ = InvokeAsync(() =>
        {
            _outcomes.Clear();
            _rollbackOutcomes.Clear();
            ResolveSelection();
            Recompute();
            StateHasChanged();
        });
    }

    private static string CountWords(int count, string noun) =>
        CaseChain.CountWords(count, noun);

    private static string FlipWords(int count, string direction) =>
        count == 1 ? $"1 flip to {direction}" : $"{count} flips to {direction}";

    private string Subtitle() =>
        _loadError is not null ? "Failed to load." :
        _users is null ? "Loading…" :
        _selected is null ? "Nobody to act as — the ERP has no users." :
        $"{CountWords(_pendingQuestions.Count, "question")} and {CountWords(_pendingApprovals.Count, "approval")} pending for {_selected}.";

    private void ResolveSelection()
    {
        if (_users is null)
        {
            _selected = null;
        }
        else
        {
            var current = Acting.CurrentUserId;
            _selected = current is not null
                && _users.Any(u => string.Equals(u.UserId, current, StringComparison.Ordinal))
                ? current
                : DecisionBoard.PickDefaultUserId(_users);
        }

        if (string.IsNullOrWhiteSpace(_memoAuthor))
        {
            _memoAuthor = _selected ?? string.Empty;
        }
    }

    private void Recompute()
    {
        if (_questions is null || _approvals is null || _delegations is null || _selected is null)
        {
            _pendingQuestions = [];
            _pendingApprovals = [];
            _historyQuestions = [];
            _historyApprovals = [];
            _covering = [];
            return;
        }

        var today = DateOnly.FromDateTime(DateTimeOffset.UtcNow.DateTime);
        _pendingQuestions = PolicyBoard.PendingQuestionsFor(_questions, _selected);
        _pendingApprovals = PolicyBoard.PendingApprovalsFor(_approvals, _selected);
        _historyQuestions = PolicyBoard.DecidedQuestionsBy(_questions, _selected);
        _historyApprovals = PolicyBoard.DecidedApprovalsBy(_approvals, _selected);
        _covering = DecisionBoard.CoveringFrom(_delegations, _selected, today);
    }

    private async Task ReloadAsync()
    {
        try
        {
            _users = await UsersSvc.ListUsersAsync();
            _delegations = await UsersSvc.ListDelegationsAsync();
            _spaces = await Kb.ListSpacesAsync();
            await RefreshAsync();
            _loadError = null;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Memos failed to load.");
            _loadError = $"Memos failed to load: {ex.Message}";
            return;
        }

        ResolveSelection();
        Recompute();
    }

    private async Task RefreshAsync()
    {
        _questions = await Views.ListQuestionCardsAsync();
        _approvals = await Views.ListApprovalCardsAsync();
        _activations = await Views.ListActivationsAsync();
    }

    private async Task OnMemoFileAsync(InputFileChangeEventArgs e)
    {
        _memoError = null;
        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxMemoUploadBytes);
            using var reader = new StreamReader(stream);
            _memoText = await reader.ReadToEndAsync();
            _memoFileName = file.Name;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Memo upload {File} failed.", file.Name);
            _memoError = $"Upload {file.Name} failed: {ex.Message}.";
            _memoFileName = null;
        }
    }

    private async Task SubmitMemoAsync()
    {
        _memoBusy = true;
        _memoError = null;
        _memoResult = null;
        try
        {
            _memoResult = await MemoSubmit.SubmitAsync(_memoAuthor, _memoText);
            if (_memoResult.Ok)
            {
                _memoText = string.Empty;
                _memoFileName = null;
                await RefreshAsync();
                Recompute();
            }
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Memo submit failed.");
            _memoError = $"Memo submit failed: {ex.Message}";
        }
        finally
        {
            _memoBusy = false;
        }
    }

    private async Task AnswerAsync(PolicyQuestionCardVm card)
    {
        if (_selected is null)
        {
            _outcomes[card.Decision.DecisionId] =
                new PolicyOutcome(false, "No acting user is selected.", []);
            return;
        }

        _busy = true;
        try
        {
            _chosenOptions.TryGetValue(card.Decision.DecisionId, out var chosen);
            var outcome = await Outcomes.AnswerQuestionAsync(
                card.MemoId, card.Decision.DecisionId, chosen, _selected);
            _outcomes[card.Decision.DecisionId] = outcome;
            await RefreshAsync();
            Recompute();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Policy answer failed for decision {DecisionId}.", card.Decision.DecisionId);
            _outcomes[card.Decision.DecisionId] = new PolicyOutcome(false, $"Answer failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeclineAsync(PolicyQuestionCardVm card)
    {
        if (_selected is null)
        {
            _outcomes[card.Decision.DecisionId] =
                new PolicyOutcome(false, "No acting user is selected.", []);
            return;
        }

        _busy = true;
        try
        {
            _declineNotes.TryGetValue(card.Decision.DecisionId, out var note);
            var outcome = await Outcomes.DeclineQuestionAsync(
                card.MemoId, card.Decision.DecisionId, _selected, note);
            _outcomes[card.Decision.DecisionId] = outcome;
            await RefreshAsync();
            Recompute();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Policy decline failed for decision {DecisionId}.", card.Decision.DecisionId);
            _outcomes[card.Decision.DecisionId] = new PolicyOutcome(false, $"Decline failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DecideAsync(PolicyApprovalCardVm card, bool approved)
    {
        if (_selected is null)
        {
            _outcomes[card.Decision.DecisionId] =
                new PolicyOutcome(false, "No acting user is selected.", []);
            return;
        }

        _busy = true;
        try
        {
            if (!PolicyLabels.TryParseEffectiveUtc(EffectiveFor(card.Decision.DecisionId), out var parsed))
            {
                _outcomes[card.Decision.DecisionId] = new PolicyOutcome(
                    false,
                    $"Effective datetime '{EffectiveFor(card.Decision.DecisionId)}' did not parse; " +
                    "use YYYY-MM-DDTHH:MM (UTC). It is mandatory on every approval.",
                    []);
                return;
            }

            _comments.TryGetValue(card.Decision.DecisionId, out var comment);
            var outcome = await Outcomes.DecideApprovalAsync(
                card.MemoId, card.Decision.DecisionId, approved, _selected,
                parsed, ApplicabilityFor(card.Decision.DecisionId),
                card.Current?.Proposal.ProposedRule is null ? null : EditedParamsFor(card),
                string.IsNullOrWhiteSpace(comment) ? null : comment,
                approved ? NewRuleSpecFor(card) : null,
                approved ? EvidenceLinesFor(card.Decision.DecisionId) : null);
            _outcomes[card.Decision.DecisionId] = outcome;
            await RefreshAsync();
            Recompute();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Policy decision failed for decision {DecisionId}.", card.Decision.DecisionId);
            _outcomes[card.Decision.DecisionId] = new PolicyOutcome(false, $"Decision failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RollbackAsync(PolicyActivationVm activation)
    {
        if (_selected is null)
        {
            _rollbackOutcomes[activation.Activation.ActivationId] =
                new PolicyOutcome(false, "No acting user is selected.", []);
            return;
        }

        _busy = true;
        try
        {
            _rollbackReasons.TryGetValue(activation.Activation.ActivationId, out var reason);
            var outcome = await Outcomes.RequestRollbackAsync(
                activation.MemoId, RollbackRestoreFor(activation), reason, _selected);
            _rollbackOutcomes[activation.Activation.ActivationId] = outcome;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Rollback request failed for activation {ActivationId}.", activation.Activation.ActivationId);
            _rollbackOutcomes[activation.Activation.ActivationId] =
                new PolicyOutcome(false, $"Rollback request failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }
}
