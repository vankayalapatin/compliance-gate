@page "/cases/{CaseId}"
@using Gate.Contracts
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject CaseViewService Views

<PageTitle>Case @CaseId</PageTitle>

<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Case @CaseId</p>
        <p class="gate-page-sub"><a href="cases">&#8592; all cases</a></p>
    </div>
</div>

@if (_loadError is not null)
{
    <ErrorBox Message="@_loadError" />
}
else if (_detail is null)
{
    <p class="gate-meta">Loading case…</p>
}
else if (_detail.Case.IsOpeningData)
{
    <section class="gate-card">
        <p class="gate-meta">Opening record — see Decisions or ERP.</p>
    </section>
}
else
{
    <section class="gate-card">
        <div class="gate-card-head">
            <p class="gate-card-title">@CaseDisplay.DisplayName(_detail.Case)</p>
            <div class="gate-card-badges">
                <span class="gate-badge">@_detail.Case.Stage</span>
                @if (_detail.Case.IsOpeningData)
                {
                    <span class="gate-chip">opening data</span>
                }
            </div>
        </div>
        <p class="gate-meta">@_detail.Case.CaseId</p>
        <ChainStrip Steps="@_detail.Chain" />
        @if (_detail.Case.BlockedByRuleId is null)
        {
            <p class="gate-meta">Not blocked.</p>
        }
        else
        {
            <div class="gate-notice" role="alert">Blocked by rule <strong>@_detail.Case.BlockedByRuleId</strong>: @(_detail.Case.BlockedReason ?? "—")</div>
        }
    </section>

    @if (_detail.MathLines.Count > 0)
    {
        <section class="gate-card">
            <p class="gate-card-title">Vendor screening math</p>
            @foreach (var line in _detail.MathLines)
            {
                <p class="gate-row">
                    @foreach (var segment in line.Segments)
                    {
                        if (segment.Href is null)
                        {
                            @segment.Text
                        }
                        else
                        {
                            <a href="@segment.Href">@segment.Text</a>
                        }
                    }
                </p>
            }
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Chain</p>
        <table class="gate-table">
            <thead>
                <tr><th>Step</th><th>Document</th><th>Status</th><th>Detail</th></tr>
            </thead>
            <tbody>
                @foreach (var step in _detail.Chain)
                {
                    <tr>
                        <td>@step.Label @if (step.IsCurrent)
                            {
                                <span class="gate-badge gate-badge-dark">current</span>
                            }</td>
                        <td>@(step.DocumentNumber ?? "—")</td>
                        <td>@step.Status</td>
                        <td>@(step.Detail ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (_detail.Case.IsOpeningData)
    {
        <section class="gate-card">
            <p class="gate-card-title">What the agent did</p>
            <p class="gate-meta">@CaseDisplay.NoAgentRun — this is opening data with no agent run behind it.</p>
        </section>
    }
    else
    {
        <section class="gate-card">
            <p class="gate-card-title">What the agent did</p>
            @if (_detail.Summary.Did.Count == 0)
            {
                <p class="gate-meta">Nothing recorded yet.</p>
            }
            else
            {
                <ul class="gate-list">
                    @foreach (var line in _detail.Summary.Did)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
        </section>

        <section class="gate-card">
            <p class="gate-card-title">What it tried and was stopped from doing</p>
            @if (_detail.Summary.Stopped.Count == 0)
            {
                <p class="gate-meta">No refusals, blocks, or waits recorded.</p>
            }
            else
            {
                <table class="gate-table">
                    <thead>
                        <tr><th>At</th><th>What</th><th>Rule</th><th>Reason</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in _detail.Summary.Stopped)
                        {
                            <tr>
                                <td>@(attempt.At?.ToString("u") ?? "—")</td>
                                <td>@attempt.What</td>
                                <td>@(attempt.RuleId ?? "—")</td>
                                <td>@attempt.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="gate-card">
            <p class="gate-card-title">Agent scorecard</p>
            <p class="gate-row"><span class="gate-label">Tool calls made:</span> @_detail.Scorecard.ToolCallsMade (@_detail.Scorecard.ToolCallsExecuted executed)</p>
            @if (_detail.Scorecard.Refused.Count == 0)
            {
                <p class="gate-meta">No refused calls.</p>
            }
            else
            {
                <table class="gate-table">
                    <thead>
                        <tr><th>Refused call</th><th>Reason</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var refusal in _detail.Scorecard.Refused)
                        {
                            <tr>
                                <td>@refusal.Tool</td>
                                <td>@refusal.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (_detail.Scorecard.Failed.Count > 0)
            {
                <table class="gate-table">
                    <thead>
                        <tr><th>Failed call</th><th>Reason</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var failure in _detail.Scorecard.Failed)
                        {
                            <tr>
                                <td>@failure.Tool</td>
                                <td>@failure.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (_detail.Scorecard.RuleSteps.Count > 0)
            {
                <p class="gate-row"><span class="gate-label">Steps done by rule instead of the agent:</span></p>
                <ul class="gate-list">
                    @foreach (var step in _detail.Scorecard.RuleSteps)
                    {
                        <li>@step.Title — @step.Detail</li>
                    }
                </ul>
            }
            @if (_detail.Scorecard.PolicyApprovals.Count > 0)
            {
                <p class="gate-row"><span class="gate-label">Approved by policy:</span></p>
                <ul class="gate-list">
                    @foreach (var approval in _detail.Scorecard.PolicyApprovals)
                    {
                        <li>@approval.Document — @approval.Detail</li>
                    }
                </ul>
            }
            <p class="gate-row"><span class="gate-label">Model calls:</span> @_detail.Scorecard.ModelCalls (@_detail.Scorecard.LiveModelCalls live, @_detail.Scorecard.CachedModelCalls from cache)</p>
            <p class="gate-row"><span class="gate-label">Tokens:</span> @Scorecard.FormatTokens(_detail.Scorecard.InputTokens) in, @Scorecard.FormatTokens(_detail.Scorecard.OutputTokens) out</p>
            @if (_detail.Scorecard.VisionReads is { } vision)
            {
                <p class="gate-row"><span class="gate-label">Vision reads:</span> @vision.Photos photos, @Scorecard.FormatTokens(vision.InputTokens) in / @Scorecard.FormatTokens(vision.OutputTokens) out tokens@(vision.EstimatedCostUsd is { } visionCost ? $" — {Scorecard.FormatCost(visionCost)}" : "")</p>
            }
            @if (_detail.Scorecard.RatesConfigured && _detail.Scorecard.EstimatedCostUsd is { } cost)
            {
                <p class="gate-row"><span class="gate-label">Estimated cost:</span> @Scorecard.FormatCost(cost) <span class="gate-meta">(ballpark from configured rates)</span></p>
            }
            else
            {
                <p class="gate-meta">Per-token rates are not configured; showing calls and tokens only.</p>
            }
        </section>
    }

    @if (_detail.OpenHolds.Count > 0)
    {
        <section class="gate-card">
            <p class="gate-card-title">Open holds</p>
            <table class="gate-table">
                <thead>
                    <tr><th>Hold</th><th>Rule</th><th>Blocks</th><th>Note</th></tr>
                </thead>
                <tbody>
                    @foreach (var hold in _detail.OpenHolds)
                    {
                        <tr>
                            <td>@hold.HoldId</td>
                            <td>@(hold.RuleId ?? "—")</td>
                            <td>@hold.DocumentType @hold.DocumentNumber @hold.PoLineRef @hold.LotRef @hold.CartonId</td>
                            <td>@hold.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Decisions</p>
        @if (_detail.Decisions.Count == 0)
        {
            <p class="gate-meta">No decisions on this case.</p>
        }
        else
        {
            <table class="gate-table">
                <thead>
                    <tr><th>Decision</th><th>Kind</th><th>Status</th><th>Rule</th><th class="gate-num">Amount</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in _detail.Decisions)
                    {
                        <tr>
                            <td><a href="decisions">@d.DecisionId</a> — @d.Title</td>
                            <td>@d.Kind</td>
                            <td><span class="gate-badge">@d.Status</span></td>
                            <td>@(d.RuleId is null ? "—" : $"{d.RuleId}: {d.Reason}")</td>
                            <td class="gate-num">@(d.Amount is null ? "—" : $"{d.Amount} {d.Currency}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="gate-card">
        <p class="gate-card-title">Vendor email (@_detail.Mail.Count)</p>
        @if (_detail.Mail.Count == 0)
        {
            <p class="gate-meta">No vendor email on this case.</p>
        }
    </section>
    @foreach (var mail in _detail.Mail.OrderBy(m => m.SentAt))
    {
        <section class="gate-card">
            <p class="gate-card-title">@mail.Subject</p>
            <p class="gate-meta">From @mail.From · to @mail.To · sent @mail.SentAt.ToString("u")</p>
            <p class="gate-row">@mail.Body</p>
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Timeline</p>
        @if (_detail.Events.Count == 0)
        {
            <p class="gate-meta">No events recorded.</p>
        }
        else
        {
            <table class="gate-table">
                <thead>
                    <tr><th>At</th><th>Actor</th><th>Event</th><th>Detail</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in _detail.Events.OrderBy(e => e.Timestamp))
                    {
                        <tr>
                            <td>@e.Timestamp.ToString("u")</td>
                            <td>@e.Actor</td>
                            <td>@CaseEventLabels.Label(e.Kind)</td>
                            <td>
                                @e.Summary
                                @if (e.RuleId is not null)
                                {
                                    <span> (rule @e.RuleId)</span>
                                }
                                @if (e.Amount is not null)
                                {
                                    <span> — @e.Amount @e.Currency</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter]
    public string CaseId { get; set; } = string.Empty;

    private CaseDetailVm? _detail;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _detail = await Views.GetCaseDetailAsync(CaseId);
            if (_detail is null)
            {
                _loadError = $"Case {CaseId} was not found.";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Case {CaseId} failed to load: {ex.Message}";
        }
    }
}
