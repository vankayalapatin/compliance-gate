@page "/admin"
@rendermode InteractiveServer
@using Gate.Agent
@using Gate.Web.Components.Outside
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject SimulationUiService Sim
@inject ModelSpendTracker Spend
@inject PresentationPace Pace
@inject ILogger<Admin> Log

<PageTitle>Admin</PageTitle>

<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Admin</p>
        <p class="gate-page-sub">Operator controls: saved data, ERP-work pickup, answers mode, presentation pace, and spend.</p>
    </div>
</div>

<section class="gate-card">
    <p class="gate-card-title">Saved data</p>
    <p class="gate-meta">Restore wipes the live workspace and copies the saved opening data back in. It runs no loader and no model call.</p>
    <ReplayControls @rendermode="InteractiveServer" />
</section>

<section class="gate-card">
    <p class="gate-card-title">ERP work</p>
    <p class="gate-meta">Pick up actionable ERP documents (approved requisitions without an order, supplier-leg orders, received invoices) into live cases. Adoption only; zero model calls.</p>
    <div class="gate-actions">
        <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="PickupAsync">Pick up ERP work</button>
        @if (_busy)
        {
            <span class="gate-meta">Working…</span>
        }
    </div>
    <OutcomeBox Outcome="@_pickup" />
</section>

<section class="gate-card">
    <p class="gate-card-title">Presentation pace</p>
    <p class="gate-meta">When on, the agent pauses two seconds between steps and the activity pane refreshes every second, so each step appears one at a time. Off is normal speed. Pacing only; nothing else changes.</p>
    <div class="gate-checkline">
        <input type="checkbox" id="pace-toggle" checked="@Pace.IsOn" @onchange="e => Pace.IsOn = e.Value is true" />
        <label for="pace-toggle">Pause between agent steps</label>
    </div>
</section>

<section class="gate-card">
    <p class="gate-card-title">Model spend</p>
    <p class="gate-row"><span class="gate-label">This session:</span> @Spend.Summary</p>
    <p class="gate-row"><span class="gate-label">Live calls:</span> @Spend.LiveCallCount</p>
    @if (Spend.CallsByModel.Count > 0)
    {
        <ul class="gate-list">
            @foreach (var kv in Spend.CallsByModel.OrderBy(kv => kv.Key, StringComparer.Ordinal))
            {
                <li>@kv.Key: @kv.Value call(s)</li>
            }
        </ul>
    }
</section>

@code {
    private bool _busy;
    private SimulationOutcome? _pickup;

    private async Task PickupAsync()
    {
        _busy = true;
        _pickup = null;
        try
        {
            var company = await Sim.GetCompanyAsync();
            _pickup = await Sim.PickUpErpWorkAsync(company?.EntityCode);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "ERP-work pickup failed.");
            _pickup = new SimulationOutcome(false, $"ERP-work pickup failed: {ex.Message}.", [], []);
        }
        finally
        {
            _busy = false;
        }
    }
}
