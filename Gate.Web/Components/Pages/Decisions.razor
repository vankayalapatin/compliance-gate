@page "/"
@page "/decisions"
@rendermode InteractiveServer
@using Gate.Contracts
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject CaseViewService Views
@inject DecisionOutcomeService Outcomes
@inject AskWhyService Why
@inject ActingUserState Acting
@inject ILogger<Decisions> Log
@implements IDisposable

<PageTitle>Decisions</PageTitle>

<div class="gate-page-head">
    <div>
        <p class="gate-page-title">Decisions</p>
        <p class="gate-page-sub">@Subtitle()</p>
    </div>
    <div>
        <button class="gate-btn" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="gate-notice gate-notice-error" role="alert">@_loadError</div>
}
else if (_cards is null || _users is null || _delegations is null)
{
    <p class="gate-meta">Loading decisions…</p>
}
else if (_selected is null)
{
    <div class="gate-notice gate-notice-error" role="alert">ERP has no users, so there is nobody to act as.</div>
}
else
{
    <section class="gate-card">
        <p class="gate-card-title">Pending for @_selected (@_pending.Count)</p>
        @if (_pending.Count == 0)
        {
            <p class="gate-meta">No pending decisions for @_selected.</p>
        }
    </section>
    @foreach (var card in _pending)
    {
        var d = card.Decision;
        <section class="gate-card">
            <div class="gate-card-head">
                <p class="gate-card-title">@d.Title</p>
                <div class="gate-card-badges">
                    @if (_covering.Count > 0)
                    {
                        <span class="gate-chip">covering @(string.Join(", ", _covering))</span>
                    }
                    <span class="gate-badge">@d.Kind</span>
                    <span class="gate-badge gate-badge-dark">Pending</span>
                </div>
            </div>
            <p class="gate-meta">
                Case <a href="cases/@d.CaseId">@d.CaseId</a>
                · SO @card.SoNumber · item @card.ItemId · stage @card.Stage
                · requested to @d.RequestedTo at @d.RequestedAt.ToString("u")
            </p>
            @if (d.Amount is not null)
            {
                <p class="gate-row"><span class="gate-label">Amount:</span> @d.Amount @d.Currency</p>
            }
            @if (d.RuleId is not null || d.Reason is not null)
            {
                <p class="gate-row"><span class="gate-label">Rule:</span> @(d.RuleId ?? "—") — @(d.Reason ?? "—")</p>
            }
            @if (card.ErpSummary is not null)
            {
                <p class="gate-row"><span class="gate-label">ERP:</span> @card.ErpSummary</p>
            }
            @if (card.EvidenceCaptions.Count > 0)
            {
                <ul class="gate-list">
                    @foreach (var caption in card.EvidenceCaptions)
                    {
                        <li>@caption</li>
                    }
                </ul>
            }
            @foreach (var image in card.ImageFileNames)
            {
                <img class="gate-img" src="dock-images/@image" alt="@image" />
            }
            <div class="gate-field">
                <label class="gate-label" for="comment-@d.DecisionId">Comment</label>
                <input class="gate-input" id="comment-@d.DecisionId" value="@CommentFor(d.DecisionId)" @onchange="e => _comments[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="gate-actions">
                <button class="gate-btn gate-btn-primary" disabled="@_busy" @onclick="() => DecideAsync(card, true)">Approve</button>
                <button class="gate-btn" disabled="@_busy" @onclick="() => DecideAsync(card, false)">Reject</button>
            </div>
            <div class="gate-ask">
                <label class="gate-label" for="why-@d.DecisionId">Ask the agent why</label>
                <div class="gate-ask-row">
                    <input class="gate-input" id="why-@d.DecisionId" value="@QuestionFor(d.DecisionId)" @onchange="e => _questions[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                    <button class="gate-btn" disabled="@_busy" @onclick="() => AskAsync(card)">Ask</button>
                </div>
                @if (_answers.TryGetValue(d.DecisionId, out var answer))
                {
                    <p class="gate-answer">@answer</p>
                }
            </div>
            @if (_outcomes.TryGetValue(d.DecisionId, out var outcome))
            {
                @if (outcome.Ok)
                {
                    <div class="gate-notice gate-notice-ok" role="alert">@outcome.Message</div>
                }
                else
                {
                    <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @outcome.Message</div>
                }
                @foreach (var warning in outcome.Warnings)
                {
                    <div class="gate-notice" role="alert">@warning</div>
                }
            }
        </section>
    }

    <section class="gate-card">
        <p class="gate-card-title">Decided by me (@_history.Count)</p>
        @foreach (var settled in _outcomes.Where(kv => _history.Any(c => c.Decision.DecisionId == kv.Key)))
        {
            @if (settled.Value.Ok)
            {
                <div class="gate-notice gate-notice-ok" role="alert">@settled.Value.Message</div>
            }
            else
            {
                <div class="gate-notice gate-notice-error" role="alert"><strong>Refused.</strong> @settled.Value.Message</div>
            }
            @foreach (var warning in settled.Value.Warnings)
            {
                <div class="gate-notice" role="alert">@warning</div>
            }
            @if (settled.Value.AdvanceFailed)
            {
                var settledCaseId = _history.First(c => c.Decision.DecisionId == settled.Key).Decision.CaseId;
                <button class="gate-btn" disabled="@_busy" @onclick="() => RetryAsync(settledCaseId, settled.Key)">Try again</button>
            }
        }
        @if (_history.Count == 0)
        {
            <p class="gate-meta">Nothing decided by @_selected yet.</p>
        }
        else
        {
            <table class="gate-table">
                <thead>
                    <tr><th>Decision</th><th>Case</th><th>Kind</th><th>Outcome</th><th>Decided at</th><th>Comment</th></tr>
                </thead>
                <tbody>
                    @foreach (var card in _history)
                    {
                        var h = card.Decision;
                        <tr>
                            <td>@h.DecisionId — @h.Title</td>
                            <td><a href="cases/@h.CaseId">@h.CaseId</a></td>
                            <td>@h.Kind</td>
                            <td><span class="gate-badge @(h.Status == DecisionStatus.Approved ? "gate-badge-dark" : "")">@h.Status</span></td>
                            <td>@(h.DecidedAt?.ToString("u") ?? "—")</td>
                            <td>@(h.Comment ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

}

@code {
    private IReadOnlyList<UserDto>? _users;
    private IReadOnlyList<DelegationDto>? _delegations;
    private IReadOnlyList<DecisionCardVm>? _cards;
    private IReadOnlyList<DecisionCardVm> _pending = [];
    private IReadOnlyList<DecisionCardVm> _history = [];
    private IReadOnlyList<string> _covering = [];
    private string? _selected;
    private string? _loadError;
    private bool _busy;
    private readonly Dictionary<string, string> _comments = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _questions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _answers = new(StringComparer.Ordinal);
    private readonly Dictionary<string, DecisionOutcome> _outcomes = new(StringComparer.Ordinal);

    private string CommentFor(string decisionId)
    {
        _comments.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string QuestionFor(string decisionId)
    {
        _questions.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        Acting.OnChange += OnActingChanged;
        await ReloadAsync();
    }

    public void Dispose()
    {
        Acting.OnChange -= OnActingChanged;
    }

    private void OnActingChanged()
    {
        // ActingUserState.OnChange is a service-raised event: it can fire
        // from any thread, so the whole handler (state touches and render)
        // marshals to the Dispatcher.
        _ = InvokeAsync(() =>
        {
            _outcomes.Clear();
            ResolveSelection();
            Recompute();
            StateHasChanged();
        });
    }

    private string Subtitle() =>
        _selected is null ? "Loading…" : $"{_pending.Count} pending for {_selected}.";

    private void ResolveSelection()
    {
        if (_users is null)
        {
            _selected = null;
            return;
        }

        var current = Acting.CurrentUserId;
        if (current is not null
            && _users.Any(u => string.Equals(u.UserId, current, StringComparison.Ordinal)))
        {
            _selected = current;
            return;
        }

        _selected = DecisionBoard.PickDefaultUserId(_users);
    }

    private void Recompute()
    {
        if (_cards is null || _delegations is null || _selected is null)
        {
            _pending = [];
            _history = [];
            _covering = [];
            return;
        }

        var today = DateOnly.FromDateTime(DateTimeOffset.UtcNow.DateTime);
        _pending = DecisionBoard.PendingFor(_cards, _selected);
        _history = DecisionBoard.DecidedBy(_cards, _selected);
        _covering = DecisionBoard.CoveringFrom(_delegations, _selected, today);
    }

    private async Task ReloadAsync()
    {
        try
        {
            _users = await Views.ListUsersAsync();
            _delegations = await Views.ListDelegationsAsync();
            _cards = await Views.ListDecisionCardsAsync();
            _loadError = null;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Decisions failed to load.");
            _loadError = $"Decisions failed to load: {ex.Message}";
            return;
        }

        ResolveSelection();
        Recompute();
    }

    private async Task DecideAsync(DecisionCardVm card, bool approved)
    {
        if (_selected is null)
        {
            _outcomes[card.Decision.DecisionId] =
                new DecisionOutcome(false, "No acting user is selected.", []);
            return;
        }

        _busy = true;
        try
        {
            _comments.TryGetValue(card.Decision.DecisionId, out var comment);
            // No pre-checks here: the attempt runs through the runner/ERP and
            // every control refusal (SoD, signing limits, self-approval,
            // delegation) comes back as the outcome message on the card.
            var outcome = await Outcomes.ApplyAsync(
                card.Decision.CaseId, card.Decision.DecisionId, approved, comment, _selected);
            _outcomes[card.Decision.DecisionId] = outcome;
            _cards = await Views.ListDecisionCardsAsync();
            Recompute();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Decision {DecisionId} failed.", card.Decision.DecisionId);
            _outcomes[card.Decision.DecisionId] =
                new DecisionOutcome(false, $"Decision failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetryAsync(string caseId, string decisionId)
    {
        _busy = true;
        try
        {
            _outcomes[decisionId] = await Outcomes.RetryAdvanceAsync(caseId);
            _cards = await Views.ListDecisionCardsAsync();
            Recompute();
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Retry advance for case {CaseId} failed.", caseId);
            _outcomes[decisionId] =
                new DecisionOutcome(false, $"Retry failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AskAsync(DecisionCardVm card)
    {
        _busy = true;
        try
        {
            _questions.TryGetValue(card.Decision.DecisionId, out var question);
            var answer = await Why.AskAsync(card.Decision.CaseId, card.Decision.DecisionId, question ?? string.Empty);
            _answers[card.Decision.DecisionId] = answer.Text;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Ask-why failed for decision {DecisionId}.", card.Decision.DecisionId);
            _answers[card.Decision.DecisionId] = $"Ask-why failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

}
