@page "/decisions"
@rendermode InteractiveServer
@using Gate.Contracts
@using Gate.Web.Services
@using Gate.Web.ViewModels
@inject CaseViewService Views
@inject DecisionOutcomeService Outcomes
@inject AskWhyService Why

<PageTitle>Decisions</PageTitle>

<h1>Decisions</h1>

@if (_loadError is not null)
{
    <ErrorBox Message="@_loadError" />
}
else if (_cards is null)
{
    <p>Loading decisions…</p>
}
else
{
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label" for="actedBy">Acting as (ERP user)</label>
            <select class="form-select" id="actedBy" @bind="_actedBy">
                <option value="">— pick the approver —</option>
                @foreach (var user in _users)
                {
                    <option value="@user.UserId">@user.UserId (@user.Role, limit @user.SigningLimit @user.LimitCurrency)</option>
                }
            </select>
        </div>
        <div class="col-md-8 d-flex align-items-end">
            <p class="text-muted mb-2">@_cards.Count(c => c.Decision.Status == DecisionStatus.Pending) pending of @_cards.Count total.</p>
        </div>
    </div>

    @if (_cards.Count == 0)
    {
        <p>No decisions in the case cache yet. Run the agent or reset-and-replay from Home.</p>
    }

    @foreach (var card in _cards)
    {
        var d = card.Decision;
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span><strong>@d.Title</strong> <span class="badge bg-secondary">@d.Kind</span></span>
                <span class="badge @(d.Status == DecisionStatus.Pending ? "bg-warning text-dark" : d.Status == DecisionStatus.Approved ? "bg-success" : "bg-danger")">@d.Status</span>
            </div>
            <div class="card-body">
                <p class="card-text">
                    Case <a href="cases/@card.Decision.CaseId">@d.CaseId</a>
                    · SO @card.SoNumber · item @card.ItemId · stage @card.Stage
                    · requested to @d.RequestedTo at @d.RequestedAt.ToString("u")
                </p>
                @if (d.Amount is not null)
                {
                    <p class="card-text"><strong>Amount:</strong> @d.Amount @d.Currency</p>
                }
                @if (d.RuleId is not null || d.Reason is not null)
                {
                    <p class="card-text"><strong>Rule:</strong> @(d.RuleId ?? "—") — @(d.Reason ?? "—")</p>
                }
                @if (card.ErpSummary is not null)
                {
                    <p class="card-text"><strong>ERP:</strong> @card.ErpSummary</p>
                }
                @if (d.DecidedBy is not null)
                {
                    <p class="card-text"><strong>Decided:</strong> @d.DecidedBy at @(d.DecidedAt?.ToString("u") ?? "—")@(d.Comment is null ? "" : $" — {d.Comment}")</p>
                }
                @if (card.EvidenceCaptions.Count > 0)
                {
                    <ul>
                        @foreach (var caption in card.EvidenceCaptions)
                        {
                            <li>@caption</li>
                        }
                    </ul>
                }
                @foreach (var image in card.ImageFileNames)
                {
                    <img src="dock-images/@image" alt="@image" class="img-thumbnail me-2 mb-2" style="max-width: 320px;" />
                }

                @if (d.Status == DecisionStatus.Pending)
                {
                    <div class="mt-2">
                        <label class="form-label" for="comment-@d.DecisionId">Comment</label>
                        <input class="form-control" id="comment-@d.DecisionId" value="@CommentFor(d.DecisionId)" @onchange="e => _comments[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="mt-2">
                        <button class="btn btn-success me-2" disabled="@_busy" @onclick="() => DecideAsync(card, true)">Approve</button>
                        <button class="btn btn-danger" disabled="@_busy" @onclick="() => DecideAsync(card, false)">Reject</button>
                    </div>
                }

                <div class="mt-3">
                    <label class="form-label" for="why-@d.DecisionId">Ask the agent why</label>
                    <div class="input-group">
                        <input class="form-control" id="why-@d.DecisionId" value="@QuestionFor(d.DecisionId)" @onchange="e => _questions[d.DecisionId] = e.Value?.ToString() ?? string.Empty" />
                        <button class="btn btn-outline-primary" disabled="@_busy" @onclick="() => AskAsync(card)">Ask</button>
                    </div>
                    @if (_answers.TryGetValue(d.DecisionId, out var answer))
                    {
                        <p class="card-text mt-2"><em>@answer</em></p>
                    }
                </div>

                @if (_outcomes.TryGetValue(d.DecisionId, out var outcome))
                {
                    <div class="mt-2">
                        <ErrorBox Message="@(outcome.Ok ? null : outcome.Message)" Warnings="@outcome.Warnings" />
                        @if (outcome.Ok)
                        {
                            <div class="alert alert-success" role="alert">@outcome.Message</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private IReadOnlyList<DecisionCardVm>? _cards;
    private IReadOnlyList<UserDto> _users = [];
    private string? _actedBy;
    private string? _loadError;
    private bool _busy;
    private readonly Dictionary<string, string> _comments = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _questions = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _answers = new(StringComparer.Ordinal);
    private readonly Dictionary<string, DecisionOutcome> _outcomes = new(StringComparer.Ordinal);

    private string CommentFor(string decisionId)
    {
        _comments.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    private string QuestionFor(string decisionId)
    {
        _questions.TryGetValue(decisionId, out var value);
        return value ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _users = await Views.ListUsersAsync().ConfigureAwait(false);
            _cards = await Views.ListDecisionCardsAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _loadError = $"Decisions failed to load: {ex.Message}";
        }
    }

    private async Task DecideAsync(DecisionCardVm card, bool approved)
    {
        _busy = true;
        try
        {
            _comments.TryGetValue(card.Decision.DecisionId, out var comment);
            var outcome = await Outcomes.ApplyAsync(
                card.Decision.CaseId, card.Decision.DecisionId, approved, comment, _actedBy ?? string.Empty)
                .ConfigureAwait(false);
            _outcomes[card.Decision.DecisionId] = outcome;
            _cards = await Views.ListDecisionCardsAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _outcomes[card.Decision.DecisionId] = new DecisionOutcome(false, $"Decision failed: {ex.Message}", []);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AskAsync(DecisionCardVm card)
    {
        _busy = true;
        try
        {
            _questions.TryGetValue(card.Decision.DecisionId, out var question);
            var answer = await Why.AskAsync(card.Decision.CaseId, card.Decision.DecisionId, question ?? string.Empty)
                .ConfigureAwait(false);
            _answers[card.Decision.DecisionId] = answer.Text;
        }
        catch (Exception ex)
        {
            _answers[card.Decision.DecisionId] = $"Ask-why failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
