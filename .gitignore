bin/
obj/
TestResults/
.vs/
# Generated scenario run state: sequence-assigned document ids per event.
scenarios/run-manifest.json
# Local sqlite databases (live app state stays untracked).
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
# Exception: the shipped baseline snapshot pair.
!Gate.Web/data/baseline/erp.db
# Minted dock views from live walks (reproducible in-app); originals stay tracked.
assets/dock/ASN-*.jpg
# Agent check runner traffic (requests, results, logs).
.agent-checks/inbox/*.json
.agent-checks/outbox/*.json
.agent-checks/outbox/*.log
.agent-checks/archive/*.json
.agent-checks/.lock
# Image-tool scratch (see DECISIONS.md 35); deliverables live in assets/.
generated_images/
Gate.Web/data/*
!Gate.Web/data/baseline/
